---
/** Короткая заставка: показывается один раз за сессию, ≤ 1.2 с. */
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <svg class="preloader__star" viewBox="0 0 40 40" width="40" height="40">
      <path d="M20 0 C21 13 27 19 40 20 C27 21 21 27 20 40 C19 27 13 21 0 20 C13 19 19 13 20 0Z" fill="currentColor"></path>
    </svg>
    <p class="preloader__name">Illia Makovetskyi</p>
    <p class="preloader__count"><span data-count>0</span>%</p>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 900;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    color: var(--color-text);
    clip-path: inset(0 0 0 0);
  }

  :global(.no-preloader) .preloader {
    display: none;
  }

  .preloader__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .preloader__star {
    color: var(--color-accent);
    animation: spin 2.4s linear infinite;
  }

  .preloader__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
  }

  .preloader__count {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import { gsap } from '../lib/motion';
  import { releaseIntro } from '../lib/intro';

  const el = document.querySelector<HTMLElement>('[data-preloader]');
  const de = document.documentElement;

  if (!el || de.classList.contains('no-preloader')) {
    el?.remove();
    releaseIntro();
  } else {
    try {
      sessionStorage.setItem('preloader-seen', '1');
    } catch {}
    const count = el.querySelector<HTMLElement>('[data-count]')!;
    const state = { n: 0 };
    gsap
      .timeline({
        onComplete: () => {
          el.remove();
        },
      })
      .to(state, {
        n: 100,
        duration: 0.9,
        ease: 'power2.inOut',
        onUpdate: () => (count.textContent = String(Math.round(state.n))),
      })
      .add(releaseIntro, '-=0.05')
      .to(el, { clipPath: 'inset(0 0 100% 0)', duration: 0.7, ease: 'power3.inOut' }, '<');
  }
</script>
