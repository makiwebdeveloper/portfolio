---
/**
 * Hero — разворот скетчбука: огромная фамилия маркером во всю ширину и
 * коллаж из мелочей вокруг полароида (координаты лесенкой, таймлайн-пилюли,
 * посадочный талон, «уравнение» Frontend + Backend, лента с этикет-принтера, штамп).
 * Без JS всё видно сразу; с JS элементы «выкладываются» по очереди.
 */
import { pick, useT, type Lang } from '../../i18n';
import { profile } from '../../data/profile';
import { STAR_FILL } from '../../lib/doodles';
import Star from '../sketch/Star.astro';
import StickStation from '../sketch/StickStation.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const [first, ...rest] = pick(profile.nameLocal, lang).split(' ');
const last = rest.join(' ');
const ringText = `${t('hero.role')} ✶ ${t('hero.ring')} ✶ `;
// Ширина фамилии в em (Caveat 700) + запас: кегль = ширина контейнера / fit
const fit = lang === 'uk' ? 4.9 : 4.4;

const stairs = ['59.33° N', '18.07° E', '(SE)', t('hero.to')];
// Черта под суммой и кружок вокруг «?» — от руки
const RULE = 'M2 5c30-2.5 70-3.5 116-1.5';
const CIRCLE = 'M22 4c-10-1-18 6-18 16s8 17 17 16 16-8 15-17C35 9 27 3 17 6';
---

<section class="hero" id="top" tabindex="-1" aria-labelledby="hero-title" data-hero data-frame-label={t('frame.hello')}>
  <div class="hero__inner container" style={`--fit: ${fit}`}>
    <!-- Имя: короткое «Illia» цветным маркером, огромная фамилия чернилами -->
    <div class="hero__head">
      <h1 class="hero__title" id="hero-title" data-hero-in>
        <span class="hero__first-row">
          <span class="hero__greeting" data-hero-fade data-roam="text" data-roam-dy="0.3">{t('hero.greeting')}</span>
          <span class="hero__first" data-hero-write data-roam="text" data-roam-dy="0.22">{first}</span>
        </span>
        <span class="hero__last-wrap">
          <span class="hero__last" data-hero-write data-roam="text" data-roam-dy="0.22">{last}</span>
          <svg class="hero__underline" viewBox="0 0 400 30" preserveAspectRatio="none" aria-hidden="true" data-draw data-roam="mid">
            <path pathLength="1" d="M6 18C80 8 170 6 250 10s110 6 140 2"></path>
            <path pathLength="1" style="--draw-delay: 0.35s" d="M40 26c70-6 150-8 230-4"></path>
          </svg>
        </span>
      </h1>

      <!-- Наклейка-штамп с вращающимся текстом -->
      <div class="hero__badge paper" aria-hidden="true" data-hero-in data-hero-fade data-roam="box" data-roam-span="0.4 0.6">
        <svg viewBox="0 0 200 200" class="hero__ring">
          <defs>
            <path id="ring-path" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"></path>
          </defs>
          <text>
            <textPath href="#ring-path" textLength="448" lengthAdjust="spacing">{ringText}</textPath>
          </text>
        </svg>
        <span class="hero__badge-mid">2026</span>
      </div>
    </div>

    <div class="hero__collage" data-hero-in>
      <!-- Левая колонка: роль, статус, координаты лесенкой, лента -->
      <div class="hero__col hero__col--left">
        <div class="hero__who" data-hero-fade>
          <p class="hero__role"><span class="mark" data-roam="text" data-roam-dy="0.12">{t('hero.role')}</span></p>
          <p class="hero__status micro">
            <Star class="hero__status-star" />
            {t('hero.available')}
          </p>
        </div>

        <ul class="hero__stairs micro" role="list" aria-label={t('hero.place')} data-hero-fade>
          {stairs.map((s, i) => <li style={`--i: ${i}`}><span data-roam="text">{s}</span></li>)}
        </ul>

        <p class="hero__label tag" data-hero-fade data-roam="box">{t('meta.description').replaceAll('-', '\u2011')}</p>
      </div>

      <!-- Центр: полароид с «терминалом», орбита и большая звезда -->
      <div class="hero__center">
        <figure class="hero__polaroid paper taped" data-hero-fade data-roam="box">
          <div class="term" aria-hidden="true">
            <div class="term__bar"><i></i><i></i><i></i></div>
            <p class="term__line" style="--n: 0"><b>&gt;</b> whoami</p>
            <p class="term__line term__out" style="--n: 1">illia, fullstack</p>
            <p class="term__line" style="--n: 2"><b>&gt;</b> stack --top</p>
            <p class="term__line term__out" style="--n: 3">react next node go</p>
            <p class="term__line" style="--n: 4"><b>&gt;</b> status</p>
            <p class="term__line term__out" style="--n: 5">open to work<span class="term__caret"></span></p>
          </div>
          <figcaption class="hero__caption">{t('hero.caption')}</figcaption>
        </figure>

        <svg class="hero__orbit" viewBox="0 0 520 240" aria-hidden="true" data-draw>
          <path
            id="hero-orbit"
            pathLength="1"
            d="M262 22C392 18 506 52 512 104c6 54-112 112-250 114C120 220 12 182 8 126 4 70 124 26 262 22z"
          ></path>
          <path pathLength="1" style="--draw-delay: 0.3s" d="M70 186c-30-14-50-34-52-58"></path>
          <g class="hero__orbiter">
            <path d={STAR_FILL} transform="translate(-11 -11) scale(0.22)"></path>
            <animateMotion dur="11s" repeatCount="indefinite">
              <mpath href="#hero-orbit"></mpath>
            </animateMotion>
          </g>
          <path class="hero__orbit-star" d={STAR_FILL} transform="translate(56 166) scale(0.2)"></path>
        </svg>

        <Star variant="both" class="hero__bigstar" data-roam="box" data-roam-span="0.42 0.58" data-roam-dy="0.04" />

        <!-- Стикмен машет у полароида: первая точка бегуна, отсюда он гуляет по Hero -->
        <div class="hero__stick-spot">
          <StickStation pose="wave" face="right" scale={1.3} class="hero__stick" perch />
        </div>
      </div>

      <!-- Правая колонка: таймлайн-пилюли, посадочный талон, чек-лист -->
      <div class="hero__col hero__col--right">
        <p class="hero__pills micro" data-hero-fade aria-label="2020 — 2026">
          <span class="pill sketch" data-roam="box">2020</span>
          <span class="pill-line"></span>
          <span class="pill sketch" data-roam="box">2026</span>
          <span class="pill-line pill-line--tail"></span>
        </p>

        <div class="hero__ticket paper" data-hero-fade data-roam="box">
          <div class="ticket__main">
            <p class="micro">{t('hero.ticket')} · 2024</p>
            <p class="ticket__route" aria-label={`${t('hero.from')} → ${t('hero.to')}`}>
              <span aria-hidden="true">HRK</span>
              <svg viewBox="0 0 60 20" aria-hidden="true">
                <path d="M2 13c14-8 30-9 50-4"></path>
                <path d="M44 3l9 6-10 5"></path>
              </svg>
              <span aria-hidden="true">ARN</span>
            </p>
            <p class="ticket__cities micro" aria-hidden="true"><span>{t('hero.from')}</span><span>{t('hero.to')}</span></p>
          </div>
          <span class="ticket__stub" aria-hidden="true"><span class="ticket__barcode"></span></span>
        </div>

        <!-- «Уравнение» маркером: Frontend + Backend = Fullstack, + ваша команда = ? -->
        <div class="hero__todo" data-hero-fade>
          <p class="micro"><span data-roam="text">{t('hero.todo')}</span></p>
          <div class="sum">
            <span class="sum__op" aria-hidden="true"></span><span>{t('hero.todo.front')}</span>
            <span class="sum__op">+</span><span>{t('hero.todo.back')}</span>
            <svg class="sum__rule" viewBox="0 0 120 8" preserveAspectRatio="none" aria-hidden="true" data-draw style="--draw-delay: 0.9s">
              <path pathLength="1" d={RULE} />
            </svg>
            <span class="sum__op">=</span><span class="sum__total" data-roam="text" data-roam-dy="0.2">{t('hero.todo.sum')}</span>
            <a href="#contact" class="sum__team">
              <span class="sum__op">+</span>
              <span>
                {t('hero.todo.team')} ={' '}
                <span class="sum__q">
                  ?
                  <svg viewBox="0 0 40 40" aria-hidden="true">
                    <path pathLength="1" d={CIRCLE} />
                  </svg>
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#intro" data-hero-in data-hero-fade>
    <span data-roam="text" data-roam-dy="0.25">{t('hero.scroll')}</span>
    <svg viewBox="0 0 40 70" width="28" height="50" aria-hidden="true">
      <path d="M22 3c-12 8-14 20-4 26s10-8 2-6S8 40 20 64"></path>
      <path d="M11 55l9 10 8-12"></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    /* высокие планшеты: не растягиваем hero на 1366px пустоты */
    min-height: min(100svh, 68rem);
    display: grid;
    align-items: center;
    padding-block: 5.5rem 4.5rem;
    outline: none;
    /* орбита и наклонённые бумажки не расширяют страницу на телефоне */
    overflow-x: clip;
  }

  .hero__inner {
    position: relative;
    container-type: inline-size;
  }

  /* ---------- Имя ---------- */
  .hero__head {
    position: relative;
  }

  .hero__title {
    display: grid;
    /* кегль фамилии: вся ширина контейнера, но на низких экранах
       (телефон в ландшафте, ноутбук 1280×720) не выше трети высоты */
    font-size: min(calc(100cqi / var(--fit)), 30svh);
    line-height: 0.86;
  }

  .hero__first-row {
    display: flex;
    align-items: baseline;
    gap: 0.25em;
    width: fit-content;
    margin: 0 0 -0.1em 0.06em;
    font-size: 0.42em;
    rotate: -4deg;
    transform-origin: left bottom;
  }
  .hero__greeting {
    font-size: 0.4em;
    font-weight: 500;
    color: var(--color-muted);
  }
  .hero__first {
    display: inline-block;
    color: var(--color-accent);
  }

  .hero__last-wrap {
    position: relative;
    width: fit-content;
  }
  .hero__last {
    display: inline-block;
  }

  .hero__underline {
    position: absolute;
    left: 4%;
    bottom: -0.08em;
    width: 94%;
    height: 0.14em;
    overflow: visible;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  /* --- Штамп --- */
  .hero__badge {
    --tilt: 8deg;
    position: absolute;
    right: 0;
    top: -0.5rem;
    width: clamp(6rem, 10vw, 9rem);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    /* вращающийся квадрат кольца не должен расширять страницу */
    overflow: clip;
  }
  .hero__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 26s linear infinite;
  }
  .hero__ring text {
    font-family: var(--font-hand);
    font-size: 21px;
    font-weight: 600;
    fill: var(--color-text);
  }
  .hero__badge-mid {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    color: var(--color-accent);
    rotate: -8deg;
  }

  /* ---------- Коллаж ---------- */
  .hero__collage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    margin-top: clamp(1.4rem, 3vw, 2.4rem);
  }

  .hero__col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.4rem;
    min-width: 0;
  }
  .hero__col--right {
    align-items: flex-end;
  }

  .hero__role {
    font-family: var(--font-hand);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
  }
  .hero__status {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.55rem;
    color: var(--color-text);
  }
  .hero__status :global(.hero__status-star) {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
    animation: twinkle 2.4s var(--ease-in-out) infinite;
  }

  /* Координаты лесенкой по диагонали */
  .hero__stairs {
    display: grid;
    gap: 0.5rem;
    color: var(--color-text);
  }
  .hero__stairs li {
    padding-left: calc(var(--i) * clamp(1.2rem, 2.6vw, 2.6rem));
  }

  .hero__label {
    max-width: 16.5rem;
    text-align: justify;
    text-align-last: justify;
  }

  /* --- Центр --- */
  .hero__center {
    position: relative;
    align-self: center;
    width: clamp(11.9rem, 18vw, 15.6rem);
    margin-inline: clamp(1rem, 5vw, 5rem);
  }

  .hero__polaroid {
    --tilt: -3deg;
    position: relative;
    z-index: 1;
    padding: 0.7rem 0.7rem 0.3rem;
  }
  .hero__caption {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    font-weight: 600;
    text-align: center;
    color: var(--color-muted);
    padding-top: 0.2rem;
  }

  /* «Экран» с терминалом */
  .term {
    aspect-ratio: 1;
    display: grid;
    align-content: start;
    gap: 0.1rem;
    padding: 0.75rem 0.8rem;
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: clamp(0.62rem, 0.72vw, 0.74rem);
    line-height: 1.5;
    overflow: hidden;
  }
  .term__bar {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 0.45rem;
  }
  .term__bar i {
    width: 0.55rem;
    aspect-ratio: 1;
    border: 1.5px solid currentColor;
    border-radius: 52% 48% 46% 54% / 55% 45% 55% 45%;
    opacity: 0.7;
  }
  .term__bar i:first-child {
    background: var(--color-accent);
    border-color: var(--color-accent);
    opacity: 1;
  }
  .term__line {
    white-space: nowrap;
  }
  .term__line b {
    color: var(--color-accent);
    font-weight: 700;
  }
  .term__out {
    opacity: 0.7;
    margin-bottom: 0.3rem;
  }
  .term__caret {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.15em;
    vertical-align: -0.15em;
    background: var(--color-accent);
    animation: caret 1s steps(1) infinite;
  }

  /* Строки «печатаются» после появления */
  :global(.js) .term__line {
    clip-path: inset(0 100% 0 0);
  }
  :global(.js) .hero.is-drawn .term__line {
    clip-path: inset(0 -1em 0 0);
    transition: clip-path 0.5s steps(14) calc(0.6s + var(--n) * 0.38s);
  }

  .hero__orbit {
    position: absolute;
    max-width: none;
    left: 50%;
    top: 50%;
    width: 215%;
    translate: -50% -47%;
    rotate: -16deg;
    overflow: visible;
    z-index: 2;
    pointer-events: none;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .hero__orbiter,
  .hero__orbit-star {
    fill: var(--color-accent);
    stroke: none;
  }

  .hero__center :global(.hero__bigstar) {
    position: absolute;
    right: -24%;
    top: -20%;
    z-index: 3;
    width: 44%;
    color: var(--color-text);
    --star-fill: var(--color-surface);
    --star-stroke: 3;
    rotate: 12deg;
  }
  /* «Кипение» звезды — на внутренних path, чтобы transform svg был свободен */
  .hero__center :global(.hero__bigstar path) {
    transform-box: fill-box;
    transform-origin: center;
    animation: boil-star var(--boil) steps(1) infinite;
  }

  /* --- Пилюли-таймлайн --- */
  .hero__pills {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    color: var(--color-text);
  }
  .pill {
    padding: 0.2rem 0.9rem 0.25rem;
    font-size: 0.8rem;
  }
  .pill::before {
    border-width: 1.5px;
    border-radius: 50% 46% 52% 48% / 60% 50% 55% 45%;
    animation-name: boil-round;
  }
  .pill-line {
    flex: 1;
    min-width: 1.5rem;
    height: 8px;
    background: var(--color-line);
    -webkit-mask: var(--wavy-line) 0 50% / 420px 8px repeat-x;
    mask: var(--wavy-line) 0 50% / 420px 8px repeat-x;
  }
  .pill-line--tail {
    flex: 0.5;
  }

  /* --- Посадочный талон --- */
  .hero__ticket {
    --tilt: 2.5deg;
    display: flex;
    width: min(100%, 16.5rem);
    border-radius: 6px;
  }
  .ticket__main {
    flex: 1;
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.9rem 0.75rem;
  }
  .ticket__route {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-hand);
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1;
  }
  .ticket__route svg {
    width: 2.6rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ticket__cities {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
  }
  /* Отрывной корешок со «штрихкодом» */
  .ticket__stub {
    width: 2.7rem;
    border-left: 2px dashed var(--color-line);
    display: grid;
    place-items: center;
  }
  .ticket__barcode {
    width: 1.4rem;
    height: 72%;
    background: repeating-linear-gradient(
      var(--color-text) 0 2px,
      transparent 2px 4px,
      var(--color-text) 4px 5px,
      transparent 5px 8px,
      var(--color-text) 8px 11px,
      transparent 11px 12px
    );
    opacity: 0.85;
  }

  /* --- Уравнение «Frontend + Backend = Fullstack» --- */
  .hero__todo {
    display: grid;
    gap: 0.3rem;
    rotate: -1.5deg;
  }
  .sum {
    display: grid;
    grid-template-columns: 1.1rem auto;
    column-gap: 0.35rem;
    align-items: baseline;
    font-family: var(--font-hand);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-muted);
  }
  .sum__op {
    text-align: center;
    color: var(--color-accent);
  }
  .sum__rule {
    grid-column: 1 / -1;
    width: 100%;
    height: 0.5rem;
    margin-block: 0.05rem 0.1rem;
    overflow: visible;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .sum__total {
    color: var(--color-text);
    font-weight: 700;
  }
  /* Последняя строка — ссылка на контакты, выровнена по той же сетке */
  .sum__team {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    margin-top: 0.15rem;
    color: var(--color-accent);
    transition: translate 0.4s var(--ease-back);
  }
  .sum__team:hover {
    translate: 4px 0;
  }
  .sum__q {
    position: relative;
    display: inline-block;
    margin-left: 0.2em;
  }
  /* Кружок вокруг «?» обводится при наведении */
  .sum__q svg {
    position: absolute;
    left: -0.4em;
    top: -0.05em;
    width: calc(100% + 0.8em);
    height: calc(100% + 0.1em);
    max-width: none; /* reset svg { max-width: 100% } сжал бы кружок до ширины «?» */
    overflow: visible;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.01;
    transition: stroke-dashoffset 0.45s var(--ease-out);
  }
  .sum__team:hover .sum__q svg,
  .sum__team:focus-visible .sum__q svg {
    stroke-dashoffset: 0;
  }

  /* --- Стикмен у полароида --- */
  .hero__stick-spot {
    position: absolute;
    right: calc(100% - 0.6rem);
    bottom: -0.6rem;
    z-index: 2;
  }
  .hero__stick-spot :global(.hero__stick) {
    display: block;
  }
  /* --- Подсказка «скролль» --- */
  .hero__scroll {
    position: absolute;
    left: max(var(--gutter), (100% - var(--max-width)) / 2);
    bottom: 1.2rem;
    display: inline-flex;
    align-items: flex-end;
    gap: 0.4rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .hero__scroll svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: nudge 1.8s var(--ease-in-out) infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes twinkle {
    50% {
      transform: rotate(18deg) scale(1.2);
    }
  }
  @keyframes nudge {
    50% {
      transform: translateY(6px);
    }
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  /* «Кипение» звезды: 3 кадра поворота/масштаба, как у рамок */
  @keyframes boil-star {
    0% {
      transform: rotate(0deg) scale(1);
    }
    33% {
      transform: rotate(3deg) scale(1.03);
    }
    66% {
      transform: rotate(-2deg) scale(0.98);
    }
  }

  :global(.is-still) .hero__ring,
  :global(.is-still) .hero__scroll svg,
  :global(.is-still) .term__caret,
  :global(.is-still) .hero__status :global(.hero__status-star),
  :global(.is-still) .hero__center :global(.hero__bigstar path) {
    animation-play-state: paused;
  }

  /* ---------- Узкие экраны: коллаж в столбик ---------- */
  @media (max-width: 899px) {
    .hero {
      min-height: auto;
      padding-block: 7rem 3.5rem;
    }
    .hero__badge {
      top: -3.4rem;
      right: 0.4rem;
      width: 5.4rem;
    }
    .hero__ring text {
      font-size: 24px;
    }
    .hero__collage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'who who'
        'center center'
        'ticket todo'
        'label label';
      gap: 1.8rem 1rem;
    }
    .hero__col {
      display: contents;
    }
    .hero__who {
      grid-area: who;
    }
    .hero__center {
      grid-area: center;
      justify-self: center;
      width: min(52vw, 240px);
      margin-block: 1.4rem 0.6rem;
    }
    .hero__ticket {
      grid-area: ticket;
      align-self: start;
      width: 100%;
    }
    .hero__todo {
      grid-area: todo;
      justify-self: end;
    }
    .hero__label {
      grid-area: label;
      max-width: 22rem;
      justify-self: start;
    }
    .hero__stairs,
    .hero__pills,
    .hero__scroll {
      display: none;
    }
    .hero__stick-spot :global(.hero__stick) {
      --s: 0.95 !important;
    }
    .ticket__route {
      font-size: 1.7rem;
    }
    .ticket__stub {
      width: 1.9rem;
    }
    .ticket__barcode {
      width: 1rem;
    }
  }

  @media (max-width: 480px) {
    .hero__collage {
      grid-template-areas:
        'who who'
        'center center'
        'ticket ticket'
        'todo todo'
        'label label';
    }
    .hero__ticket {
      width: min(100%, 17rem);
    }
    .hero__todo {
      justify-self: start;
    }
  }
</style>

<script>
  import { gsap, fontsReady, reducedMotion } from '../../lib/motion';
  import { introDone } from '../../lib/intro';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const orbit = hero.querySelector<SVGSVGElement>('.hero__orbit')!;
  const de = document.documentElement;

  /* Звёздочка на орбите (SMIL) стоит, когда reduced motion, пауза или
     hero вне экрана: так она не тратит кадры впустую. */
  let visible = true;
  const syncOrbit = () => {
    const still = reducedMotion.matches || de.classList.contains('is-still') || !visible;
    if (still) orbit.pauseAnimations();
    else orbit.unpauseAnimations();
  };
  new MutationObserver(syncOrbit).observe(de, { attributes: true, attributeFilter: ['class'] });
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    syncOrbit();
  }).observe(hero);
  reducedMotion.addEventListener('change', syncOrbit);
  syncOrbit();

  async function enter() {
    // Смена языка (src/lib/relang.ts): hero сразу в готовом виде, без повторного входа
    if (de.classList.contains('is-relang')) {
      hero.classList.add('is-drawn');
      return;
    }

    await Promise.all([introDone, fontsReady()]);

    if (reducedMotion.matches) {
      de.classList.remove('is-entering');
      hero.classList.add('is-drawn');
      return;
    }

    // Имя «пишется» маркером слева направо. Текст не делим на буквы:
    // у Caveat контекстные формы букв (зависят от соседей), и в отдельных
    // <span> он выглядит как другой шрифт, а края штрихов обрезаются.
    // Отрицательные inset — запас под выносные штрихи.
    const lines = hero.querySelectorAll<HTMLElement>('[data-hero-write]');
    const fades = hero.querySelectorAll<HTMLElement>('[data-hero-fade]');
    const bigStar = hero.querySelector<SVGElement>('.hero__bigstar');

    gsap.set(lines, { clipPath: 'inset(-30% 100% -40% -10%)', y: 8, rotate: -1.5 });
    gsap.set(fades, { autoAlpha: 0, y: 24, rotate: -3 });
    gsap.set(bigStar, { autoAlpha: 0, scale: 0.2, rotate: -120 });
    de.classList.remove('is-entering');

    gsap
      .timeline()
      .to(lines, {
        clipPath: 'inset(-30% -10% -40% -10%)',
        y: 0,
        rotate: 0,
        duration: 0.85,
        stagger: 0.35,
        ease: 'power2.inOut',
        clearProps: 'clipPath,transform',
      })
      .to(
        fades,
        { autoAlpha: 1, y: 0, rotate: 0, duration: 0.8, stagger: 0.07, ease: 'expo.out', clearProps: 'transform' },
        0.45,
      )
      .add(() => hero.classList.add('is-drawn'), 0.9)
      .to(bigStar, { autoAlpha: 1, scale: 1, rotate: 0, duration: 1, ease: 'back.out(2.2)', clearProps: 'transform' }, 1.1);
  }

  enter();
</script>
