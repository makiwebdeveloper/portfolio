---
import { pick, useT, type Lang } from '../../i18n';
import { profile } from '../../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const [first, ...rest] = pick(profile.nameLocal, lang).split(' ');
const last = rest.join(' ');
const ringText = `${t('hero.role')} · ${t('hero.place')} · `;
---

<section class="hero" id="top" tabindex="-1" data-scene="0" aria-labelledby="hero-title">
  <div class="hero__inner container">
    <p class="hero__greeting" data-hero-in data-hero-fade>{t('hero.greeting')}</p>

    <h1 class="hero__title" id="hero-title" data-hero-in>
      <span class="hero__line" data-hero-split>{first}</span>
      <span class="hero__line hero__line--indent" data-hero-split>{last}</span>
    </h1>

    <div class="hero__meta" data-hero-in data-hero-fade>
      <p class="hero__role">{t('hero.role')}</p>
      <p class="hero__place">{t('hero.place')}</p>
      <p class="hero__status"><span class="hero__pulse" aria-hidden="true"></span>{t('hero.available')}</p>
    </div>

    <div class="hero__badge" aria-hidden="true" data-hero-in data-hero-fade>
      <svg viewBox="0 0 200 200" class="hero__ring">
        <defs>
          <path id="ring-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
        </defs>
        <text>
          <textPath href="#ring-path" textLength="486" lengthAdjust="spacing">{ringText}</textPath>
        </text>
      </svg>
      <svg viewBox="0 0 24 24" class="hero__badge-star">
        <path d="M12 0C12.6 7.8 16.2 11.4 24 12C16.2 12.6 12.6 16.2 12 24C11.4 16.2 7.8 12.6 0 12C7.8 11.4 11.4 7.8 12 0Z"></path>
      </svg>
    </div>

  </div>

  <a class="hero__scroll" href="#intro" data-hero-in data-hero-fade>
    <span>{t('hero.scroll')}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 7rem 4rem;
    outline: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .hero__greeting {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--color-muted);
  }

  .hero__title {
    font-size: min(var(--step-5), 15vw);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .hero__line {
    display: block;
  }

  .hero__line--indent {
    padding-left: clamp(1.5rem, 12vw, 14rem);
    font-style: italic;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin-top: clamp(1rem, 3vw, 3rem);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__role {
    color: var(--color-text);
  }
  .hero__place {
    color: var(--color-muted);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--color-muted);
  }

  .hero__pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: pulse 2s var(--ease-out) infinite;
  }

  .hero__badge {
    position: absolute;
    right: 0;
    top: 50%;
    width: clamp(7rem, 14vw, 12rem);
    aspect-ratio: 1;
    translate: 0 -60%;
  }

  .hero__ring {
    width: 100%;
    height: 100%;
    animation: spin 22s linear infinite;
  }
  .hero__ring text {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--color-text);
  }

  .hero__badge-star {
    position: absolute;
    inset: 36%;
    fill: var(--color-accent);
    animation: spin 9s linear infinite reverse;
  }

  .hero__scroll {
    position: absolute;
    left: max(var(--gutter), (100% - var(--max-width)) / 2);
    bottom: 2rem;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 3.5rem;
    background: var(--color-line);
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-text);
    animation: drip 2.2s var(--ease-in-out) infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes pulse {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  @keyframes drip {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 820px) {
    .hero__line--indent {
      padding-left: 8vw;
    }
    .hero__badge {
      top: auto;
      bottom: -7rem;
      translate: none;
      width: 6.5rem;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>

<script>
  import { gsap, fontsReady, reducedMotion } from '../../lib/motion';
  import { introDone } from '../../lib/intro';
  import { splitText } from '../../lib/split';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const de = document.documentElement;

  async function enter() {
    await Promise.all([introDone, fontsReady()]);

    if (reducedMotion.matches) {
      de.classList.remove('is-entering');
      return;
    }

    const lines = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-split]'));
    const chars = lines.flatMap((l) => splitText(l, 'chars'));
    const fades = hero.querySelectorAll<HTMLElement>('[data-hero-fade]');

    gsap.set(chars, { yPercent: 110, rotate: 6 });
    gsap.set(fades, { autoAlpha: 0, y: 24 });
    de.classList.remove('is-entering');

    gsap
      .timeline({ defaults: { ease: 'expo.out' } })
      .to(chars, { yPercent: 0, rotate: 0, duration: 1.4, stagger: 0.035 })
      .to(fades, { autoAlpha: 1, y: 0, duration: 1.1, stagger: 0.08 }, 0.35);

    // Лёгкий параллакс при уходе со сцены
    gsap.to(hero.querySelector('.hero__inner'), {
      yPercent: -12,
      opacity: 0.2,
      ease: 'none',
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
    });
  }

  enter();
</script>
