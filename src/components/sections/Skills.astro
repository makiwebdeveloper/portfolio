---
import { pick, useT, type Lang } from '../../i18n';
import { skills, spoken } from '../../data/profile';
import Underline from '../sketch/Underline.astro';
import StickStation from '../sketch/StickStation.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const groups = [
  { label: t('skills.languages'), items: skills.languages, tilt: -1.2, tape: -5 },
  { label: t('skills.tech'), items: skills.tech, tilt: 0.8, tape: 3 },
  { label: t('skills.tools'), items: skills.tools, tilt: -0.6, tape: -2 },
];
const tagTilts = [-3, 2, -1.5, 3];
// Декоративная лента: все навыки подряд, вперемешку по группам
const band = [...skills.tech.slice(0, 5), ...skills.languages.slice(0, 4), ...skills.tools.slice(0, 5)];
const toolCount = skills.languages.length + skills.tech.length + skills.tools.length;
---

<section class="skills section" id="skills" tabindex="-1" aria-labelledby="skills-title" data-frame-label={t('nav.skills')}>
  <StickStation pose="juggle" class="lane-station" />
  <div class="container skills__head">
    <p class="eyebrow" data-reveal>{t('skills.eyebrow')}</p>
    <h2 class="skills__title" id="skills-title" data-reveal data-write style="--reveal-i: 1">
      <span class="title-u">{t('skills.title')}<Underline variant="wave" perch="juggle" /></span>
    </h2>
    <p class="micro skills__count" data-reveal style="--reveal-i: 2">({toolCount} {t('skills.count')})</p>
  </div>

  {/* Живость секции: лента этикет-принтера наискось через лист. Чисто декоративная,
      сами навыки читаются в карточках ниже */}
  <div class="skills__band" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="skills__band-track" role="list">
        {band.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    ))}
  </div>

  {/* Все навыки видны сразу: рекрутер ищет глазами знакомые слова, бегущая строка мешала */}
  <div class="skills__grid container">
    {
      groups.map((g, i) => (
        <div
          class="skills__card paper taped"
          data-reveal
          style={`--reveal-i: ${i}; --tilt: ${g.tilt}deg; --tape-tilt: ${g.tape}deg`}
          data-perch={(['juggle', 'stand', 'point'] as const)[i % 3]}
          data-perch-at={[0.8, 0.45, 0.82][i % 3]}
          data-perch-face={i % 2 ? 'right' : 'left'}
        >
          <h3 class="skills__label">
            {g.label} <span class="micro">({String(g.items.length).padStart(2, '0')})</span>
          </h3>
          <ul class="skills__list" role="list">
            {g.items.map((s, n) => (
              <li style={`--n: ${n}`}>{s}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="container spoken" data-reveal data-perch="wave" data-perch-at="0.7" data-perch-face="left">
    <h3 class="skills__label">{t('skills.spoken')}</h3>
    <ul class="spoken__list" role="list">
      {
        spoken.map((s, i) => (
          <li class="paper" style={`--tilt: ${tagTilts[i % tagTilts.length]}deg`}>
            <span class="spoken__hole" aria-hidden="true" />
            <span class="spoken__name">{pick(s.name, lang)}</span>
            <span class="spoken__level">{pick(s.level, lang)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills {
    outline: none;
    /* свой слой: при раскрытии проектов выше секция сдвигается без перерисовки */
    will-change: transform;
    /* лента шире экрана и наклонена: без clip расширяет layout viewport на телефоне */
    overflow-x: clip;
    --station-top: calc(var(--section-space) + 3.5rem);
  }

  .skills__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .skills__title {
    font-size: var(--step-4);
  }

  /* --- Лента: тёмная полоса наискось, бесконечно едет --- */
  .skills__band {
    display: flex;
    width: calc(100% + 10rem);
    margin: 0 -5rem clamp(2.8rem, 6vw, 4.2rem);
    overflow: hidden;
    color: var(--color-bg);
    background: var(--color-text);
    rotate: -2.2deg;
    box-shadow: 0 3px 0 var(--color-shadow);
  }
  .skills__band-track {
    flex: none;
    display: flex;
    min-width: max-content;
    animation: band 60s linear infinite;
  }
  :global(.is-still) .skills__band-track {
    animation-play-state: paused;
  }
  .skills__band li {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    padding: 0.35rem 0 0.45rem 1.4rem;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1;
    white-space: nowrap;
  }
  .skills__band li::after {
    content: '✶';
    font-size: 0.45em;
    color: var(--color-accent);
  }
  @keyframes band {
    to {
      transform: translateX(-100%);
    }
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: start;
    gap: clamp(2rem, 4vw, 2.8rem) clamp(1.4rem, 3vw, 2.2rem);
  }

  .skills__card {
    padding: clamp(1.5rem, 3vw, 2rem) clamp(1.2rem, 2.5vw, 1.6rem) clamp(1.3rem, 2.5vw, 1.7rem);
  }

  .skills__label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-hand);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: 0.9rem;
  }
  .skills__label .micro {
    font-size: 0.65rem;
  }

  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.45rem;
  }

  /* Навык: подписанная от руки бирка в неровной рамке (статичной, без boil) */
  .skills__list li {
    padding: 0.15em 0.6em 0.2em;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.1;
    white-space: nowrap;
    border: 1.5px solid var(--color-line);
    border-radius: var(--wobble);
    transition:
      rotate 0.4s var(--ease-back),
      background-color 0.2s;
  }
  .skills__list li:nth-child(3n + 2) {
    rotate: -1.5deg;
  }
  .skills__list li:nth-child(3n) {
    rotate: 1deg;
  }
  .skills__list li:hover {
    rotate: 0deg;
    background: var(--color-highlight);
  }

  /* Бирки «шлёпаются» на карточку по одной, когда она появилась.
     Свои задержки у каждого свойства: ховер (rotate/фон) не ждёт очереди */
  :global(.js) .skills__card li {
    opacity: 0;
    scale: 0.4;
  }
  :global(.js) .skills__card:global(.is-in) li {
    opacity: 1;
    scale: 1;
    transition:
      opacity 0.25s var(--ease-out) var(--pop-delay),
      scale 0.55s var(--ease-back) var(--pop-delay),
      rotate 0.4s var(--ease-back),
      background-color 0.2s;
    --pop-delay: calc(0.35s + var(--reveal-i, 0) * 90ms + var(--n) * 55ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .skills__band {
      display: none;
    }
    :global(.js) .skills__card li {
      opacity: 1;
      scale: 1;
    }
  }

  /* --- Языки: бумажные бирки на ниточке --- */
  .spoken {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .spoken__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.4rem;
  }

  .spoken__list li {
    display: grid;
    gap: 0.1rem;
    padding: 1rem 1.2rem 1.1rem 2.6rem;
    border-radius: 6px 22px 22px 6px / 6px 50% 50% 6px;
    transition: rotate 0.5s var(--ease-back);
  }
  .spoken__list li:hover {
    rotate: 0deg;
  }

  .spoken__hole {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: -0.375rem;
    border-radius: 50%;
    border: 2px solid var(--color-line);
    background: var(--color-bg);
  }

  .spoken__name {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1;
  }

  .spoken__level {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-muted);
  }
</style>
