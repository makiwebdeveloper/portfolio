---
import { pick, useT, type Lang } from '../../i18n';
import { chapters } from '../../data/timeline';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const firstYear = chapters[0].year.split('');
---

<section class="story" id="story" tabindex="-1" aria-labelledby="story-title" data-story style={`--count: ${chapters.length}`}>
  <div class="container story__head">
    <p class="eyebrow" data-reveal>{t('story.eyebrow')}</p>
    <h2 class="story__title" id="story-title" data-reveal style="--reveal-i: 1">{t('story.title')}</h2>
  </div>

  <div class="story__track" data-story-track>
    <div class="story__sticky container">
      <!-- Большой «одометр» года: виден только в закреплённом режиме -->
      <div class="story__year" aria-hidden="true" data-story-year>
        {
          firstYear.map((d) => (
            <span class="odo" style={`--d: ${d}`}>
              <span class="odo__strip">
                {Array.from({ length: 10 }, (_, n) => (
                  <span>{n}</span>
                ))}
              </span>
            </span>
          ))
        }
      </div>

      <ol class="story__dots" aria-hidden="true">
        {chapters.map((_, i) => <li data-story-dot={i} />)}
      </ol>

      <ol class="story__list" role="list">
        {
          chapters.map((c, i) => (
            <li class="story__chapter" data-chapter={i} data-chapter-scene={c.scene} data-year={c.year}>
              <p class="story__chapter-year">{c.year}</p>
              <p class="story__place">
                <span class="story__index">{String(i + 1).padStart(2, '0')}</span>
                {pick(c.place, lang)}
              </p>
              <h3 class="story__chapter-title">{pick(c.title, lang)}</h3>
              <p class="story__text">{pick(c.text, lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    padding-top: var(--section-space);
    outline: none;
  }

  .story__head {
    display: grid;
    gap: 1.2rem;
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }

  .story__title {
    font-size: var(--step-4);
    max-width: 14ch;
  }

  /* ---------- Обычный режим (мобильные, без JS, reduced motion) ---------- */
  .story__year,
  .story__dots {
    display: none;
  }

  .story__list {
    display: grid;
    gap: clamp(4rem, 10vw, 8rem);
    padding-bottom: var(--section-space);
  }

  .story__chapter {
    display: grid;
    gap: 0.8rem;
    max-width: 640px;
    padding-left: clamp(0rem, 8vw, 8rem);
  }
  .story__chapter:nth-child(even) {
    margin-left: auto;
  }

  .story__chapter-year {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    font-style: italic;
    color: var(--color-accent);
  }

  .story__place {
    display: flex;
    gap: 0.8em;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .story__index {
    color: var(--color-text);
  }

  .story__chapter-title {
    font-size: var(--step-3);
  }

  .story__text {
    color: var(--color-muted);
    max-width: 52ch;
  }

  /* ---------- Закреплённый режим (desktop + анимации включены) ---------- */
  .story.is-pinned .story__track {
    height: calc(var(--count) * 85svh + 100svh);
  }

  .story.is-pinned .story__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: var(--gutter);
  }

  .story.is-pinned .story__year {
    display: flex;
    font-family: var(--font-display);
    font-size: clamp(7rem, 17vw, 18rem);
    line-height: 1;
    font-style: italic;
    color: var(--color-accent);
    letter-spacing: -0.04em;
  }

  /* Высота ячейки с запасом под выносные элементы курсивных цифр */
  .odo {
    --cell: 1.3em;
    display: inline-block;
    height: var(--cell);
    overflow: hidden;
    padding-inline: 0.04em;
  }
  .odo__strip {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--d) * -1 * var(--cell)));
    transition: transform 1.1s var(--ease-out);
  }
  .odo__strip span {
    height: var(--cell);
    line-height: var(--cell);
  }
  .odo:nth-child(2) .odo__strip { transition-delay: 0.05s; }
  .odo:nth-child(3) .odo__strip { transition-delay: 0.1s; }
  .odo:nth-child(4) .odo__strip { transition-delay: 0.15s; }

  .story.is-pinned .story__dots {
    position: absolute;
    left: var(--gutter);
    bottom: 3rem;
    display: flex;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }
  .story__dots li {
    width: 28px;
    height: 2px;
    background: var(--color-line);
    transition: background 0.4s, width 0.6s var(--ease-out);
  }
  .story__dots li.is-active {
    width: 56px;
    background: var(--color-text);
  }

  .story.is-pinned .story__list {
    display: grid;
    padding: 0;
  }

  .story.is-pinned .story__chapter {
    grid-area: 1 / 1;
    padding: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(2.5rem);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.8s var(--ease-out),
      visibility 0s 0.6s;
  }

  .story.is-pinned .story__chapter.is-past {
    transform: translateY(-2.5rem);
  }

  .story.is-pinned .story__chapter.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0.15s, 0.15s, 0s;
  }

  .story.is-pinned .story__chapter-year {
    display: none;
  }
</style>

<script>
  import { ScrollTrigger, gsap, initReveals } from '../../lib/motion';
  import { tweenScene } from '../../lib/scene';

  const section = document.querySelector<HTMLElement>('[data-story]')!;
  const track = section.querySelector<HTMLElement>('[data-story-track]')!;
  const items = Array.from(section.querySelectorAll<HTMLElement>('[data-chapter]'));
  const dots = Array.from(section.querySelectorAll<HTMLElement>('[data-story-dot]'));
  const odos = Array.from(section.querySelectorAll<HTMLElement>('.odo'));

  let current = -1;

  function activate(i: number) {
    if (i === current) return;
    current = i;
    items.forEach((el, n) => {
      el.classList.toggle('is-active', n === i);
      el.classList.toggle('is-past', n < i);
    });
    dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
    const digits = (items[i]?.dataset.year ?? '').split('');
    odos.forEach((o, n) => o.style.setProperty('--d', digits[n] ?? '0'));
    tweenScene(Number(items[i]?.dataset.chapterScene) || 0);
  }

  const mm = gsap.matchMedia();

  // Desktop с анимациями: глава закреплена, главы сменяют друг друга по скроллу.
  mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
    section.classList.add('is-pinned');
    ScrollTrigger.refresh();
    const st = ScrollTrigger.create({
      trigger: track,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => activate(Math.min(items.length - 1, Math.floor(self.progress * items.length))),
      onEnter: () => activate(Math.max(current, 0)),
      onEnterBack: () => activate(Math.max(current, 0)),
      onLeaveBack: () => tweenScene(0),
    });
    activate(0);

    return () => {
      st.kill();
      section.classList.remove('is-pinned');
      items.forEach((el) => el.classList.remove('is-active', 'is-past'));
      current = -1;
    };
  });

  // Мобильные / reduced motion: обычный список, сцена меняется по каждой главе.
  mm.add('(max-width: 899px), (prefers-reduced-motion: reduce)', () => {
    items.forEach((el) => el.setAttribute('data-reveal', ''));
    initReveals(section);
    const triggers = items.map((el) =>
      ScrollTrigger.create({
        trigger: el,
        start: 'top 60%',
        end: 'bottom 40%',
        onToggle: (self) => self.isActive && tweenScene(Number(el.dataset.chapterScene) || 0),
      }),
    );
    return () => {
      triggers.forEach((t) => t.kill());
      items.forEach((el) => el.removeAttribute('data-reveal'));
    };
  });
</script>
