---
import { pick, useT, type Lang } from '../../i18n';
import { projects } from '../../data/projects';
import ProjectVisual from '../ProjectVisual.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="work section" id="work" tabindex="-1" data-scene="0" aria-labelledby="work-title">
  <div class="container">
    <header class="work__head">
      <p class="eyebrow" data-reveal>{t('work.eyebrow')}</p>
      <h2 class="work__title" id="work-title" data-reveal style="--reveal-i: 1">{t('work.title')}</h2>
      <p class="work__lead" data-reveal style="--reveal-i: 2">{t('work.lead')}</p>
    </header>

    <ol class="work__list" role="list" data-work-list>
      {
        projects.map((p, i) => (
          <li class="project" id={`work-${p.slug}`} data-project={p.slug} data-reveal style={`--reveal-i: ${i % 3}`}>
            <h3 class="project__heading">
              <button
                type="button"
                class="project__row"
                aria-expanded="false"
                aria-controls={`panel-${p.slug}`}
                id={`btn-${p.slug}`}
                data-cursor={t('work.open')}
                data-label-open={t('work.open')}
                data-label-close={t('work.close')}
              >
                <span class="project__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="project__name">{p.title}</span>
                <span class="project__tagline">{pick(p.tagline, lang)}</span>
                <span class="project__year">{p.year}</span>
                <span class="project__plus" aria-hidden="true" />
              </button>
            </h3>

            <div
              class="project__panel"
              id={`panel-${p.slug}`}
              role="region"
              aria-labelledby={`btn-${p.slug}`}
              data-panel
            >
              <div class="project__panel-inner">
                <div class="project__body">
                  <ProjectVisual project={p} class="project__visual" />
                  <div class="project__info">
                    <p class="project__summary">{pick(p.summary, lang)}</p>

                    <dl class="project__facts">
                      <div>
                        <dt>{t('work.role')}</dt>
                        <dd>{p.solo ? t('work.solo') : t('work.team')}</dd>
                      </div>
                      <div>
                        <dt>{t('work.year')}</dt>
                        <dd>{p.year}</dd>
                      </div>
                      <div class="project__stack">
                        <dt>{t('work.stack')}</dt>
                        <dd>
                          <ul role="list">
                            {p.stack.map((s) => (
                              <li>{s}</li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                    </dl>

                    {p.highlight && (
                      <aside class="project__highlight">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                          <path d="M12 0C12.6 7.8 16.2 11.4 24 12C16.2 12.6 12.6 16.2 12 24C11.4 16.2 7.8 12.6 0 12C7.8 11.4 11.4 7.8 12 0Z" />
                        </svg>
                        <div>
                          <p class="project__highlight-label">{t('work.highlight')}</p>
                          <p>{pick(p.highlight, lang)}</p>
                        </div>
                      </aside>
                    )}

                    {p.links && p.links.length > 0 && (
                      <ul class="project__links" role="list">
                        {p.links.map((l) => (
                          <li>
                            <a class="pill" href={l.href} target="_blank" rel="noopener">
                              {l.label} ↗
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Превью за курсором (только мышь) -->
  <div class="work__preview" aria-hidden="true" data-preview>
    {projects.map((p) => <ProjectVisual project={p} class="work__preview-item" />)}
  </div>
</section>

<style>
  .work {
    outline: none;
  }

  .work__head {
    display: grid;
    gap: 1.2rem;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .work__title {
    font-size: var(--step-4);
  }

  .work__lead {
    max-width: 46ch;
    color: var(--color-muted);
  }

  .work__list {
    border-top: 1px solid var(--color-line);
  }

  .project {
    border-bottom: 1px solid var(--color-line);
  }

  .project__heading {
    font: inherit;
  }

  .project__row {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.2fr) minmax(0, 1.4fr) 4rem 2rem;
    align-items: center;
    gap: 1rem;
    padding: clamp(1.2rem, 2.5vw, 2rem) 0;
    text-align: left;
    isolation: isolate;
  }

  /* заливка строки снизу вверх при наведении */
  .project__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    z-index: -1;
    background: var(--color-surface);
    border-radius: 8px;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-out);
  }
  .project__row:hover::before,
  .project__row[aria-expanded='true']::before {
    transform: scaleY(1);
  }

  .project__num,
  .project__year {
    font-size: var(--step--1);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .project__name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    transition: transform 0.5s var(--ease-out), font-style 0.3s;
  }
  .project__row:hover .project__name {
    transform: translateX(0.4rem);
    font-style: italic;
  }

  .project__tagline {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .project__plus {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
    justify-self: end;
  }
  .project__plus::before,
  .project__plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out);
  }
  .project__plus::after {
    transform: rotate(90deg);
  }
  [aria-expanded='true'] .project__plus::after {
    transform: rotate(0deg);
  }

  /* --- Панель: анимация высоты через grid 0fr → 1fr --- */
  .project__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s var(--ease-in-out);
  }
  .project.is-open .project__panel {
    grid-template-rows: 1fr;
  }
  .project__panel-inner {
    overflow: hidden;
    min-height: 0;
  }
  /* Без JS всё раскрыто */
  :global(html:not(.js)) .project__panel {
    grid-template-rows: 1fr;
  }

  .project__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: 0.5rem 0 clamp(2rem, 4vw, 3rem) 4rem;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.5s, transform 0.7s var(--ease-out);
  }
  .project.is-open .project__body,
  :global(html:not(.js)) .project__body {
    opacity: 1;
    transform: none;
    transition-delay: 0.15s;
  }

  .project__info {
    display: grid;
    gap: 1.6rem;
    align-content: start;
  }

  .project__summary {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .project__facts {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 1rem 2.5rem;
    font-size: var(--step--1);
  }
  .project__facts dt {
    color: var(--color-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.7rem;
    margin-bottom: 0.3rem;
  }
  .project__facts dd {
    margin: 0;
  }
  .project__stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .project__stack li {
    padding: 0.2em 0.7em;
    border: 1px solid var(--color-line);
    border-radius: 999px;
  }

  .project__highlight {
    display: flex;
    gap: 0.9rem;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--color-accent) 10%, var(--color-surface));
  }
  .project__highlight svg {
    flex: none;
    fill: var(--color-accent);
    margin-top: 0.2rem;
  }
  .project__highlight-label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* --- Превью за курсором --- */
  .work__preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: clamp(220px, 22vw, 340px);
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition:
      opacity 0.35s,
      scale 0.5s var(--ease-out);
    display: none;
  }
  .work__preview.is-visible {
    opacity: 1;
    scale: 1;
  }
  :global(html.has-cursor) .work__preview {
    display: grid;
  }
  .work__preview :global(.work__preview-item) {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.3s;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.18);
  }
  .work__preview :global(.work__preview-item.is-current) {
    opacity: 1;
  }

  @media (max-width: 820px) {
    .project__row {
      grid-template-columns: 2.2rem 1fr 1.5rem;
      grid-template-areas:
        'num name plus'
        '. tag tag';
      row-gap: 0.3rem;
    }
    .project__num {
      grid-area: num;
    }
    .project__name {
      grid-area: name;
    }
    .project__tagline {
      grid-area: tag;
    }
    .project__plus {
      grid-area: plus;
    }
    .project__year {
      display: none;
    }
    .project__body {
      grid-template-columns: 1fr;
      padding-left: 0;
    }
    .project__facts {
      grid-template-columns: auto auto;
    }
    .project__stack {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../lib/motion';

  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
  const preview = document.querySelector<HTMLElement>('[data-preview]')!;
  const previewItems = Array.from(preview.querySelectorAll<HTMLElement>('.work__preview-item'));

  /* ---------- Аккордеон ---------- */
  function setOpen(item: HTMLElement, open: boolean) {
    const btn = item.querySelector<HTMLButtonElement>('.project__row')!;
    const panel = item.querySelector<HTMLElement>('[data-panel]')!;
    item.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.dataset.cursor = open ? btn.dataset.labelClose : btn.dataset.labelOpen;
    panel.inert = !open;
    // высота страницы меняется — пересчитать триггеры после перехода
    panel.addEventListener('transitionend', () => ScrollTrigger.refresh(), { once: true });
  }

  items.forEach((item) => {
    setOpen(item, false);
    item.querySelector('.project__row')!.addEventListener('click', () => {
      const willOpen = !item.classList.contains('is-open');
      items.forEach((other) => other !== item && other.classList.contains('is-open') && setOpen(other, false));
      setOpen(item, willOpen);
    });
  });

  // Ссылка вида #work-focal открывает нужный проект
  const fromHash = location.hash.startsWith('#work-') && items.find((i) => `#work-${i.dataset.project}` === location.hash);
  if (fromHash) setOpen(fromHash, true);

  /* ---------- Превью за курсором ---------- */
  const xTo = gsap.quickTo(preview, 'x', { duration: 0.6, ease: 'power3.out' });
  const yTo = gsap.quickTo(preview, 'y', { duration: 0.6, ease: 'power3.out' });
  const rotTo = gsap.quickTo(preview, 'rotate', { duration: 0.8, ease: 'power3.out' });
  let lastX = 0;

  const list = document.querySelector<HTMLElement>('[data-work-list]')!;
  list.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    xTo(e.clientX + 24);
    yTo(e.clientY - preview.offsetHeight / 2);
    rotTo(gsap.utils.clamp(-8, 8, (e.clientX - lastX) * 0.6));
    lastX = e.clientX;
  });

  items.forEach((item, i) => {
    const row = item.querySelector<HTMLElement>('.project__row')!;
    row.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || item.classList.contains('is-open')) return;
      if (!preview.classList.contains('is-visible')) {
        gsap.set(preview, { x: e.clientX + 24, y: e.clientY - preview.offsetHeight / 2 });
      }
      previewItems.forEach((p, n) => p.classList.toggle('is-current', n === i));
      preview.classList.add('is-visible');
    });
    row.addEventListener('pointerleave', () => preview.classList.remove('is-visible'));
    row.addEventListener('click', () => preview.classList.remove('is-visible'));
  });
</script>
