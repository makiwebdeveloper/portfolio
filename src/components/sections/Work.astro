---
import { pick, useT, type Lang } from '../../i18n';
import { projects } from '../../data/projects';
import ProjectVisual from '../ProjectVisual.astro';
import Underline from '../sketch/Underline.astro';
import StickStation from '../sketch/StickStation.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const tilts = [-2, 1.5, -1, 2, -1.5, 1];
const years = projects.map((p) => Number(p.year));
const range = `${Math.min(...years)}—${Math.max(...years)}`;
---

<section class="work section invert" id="work" tabindex="-1" aria-labelledby="work-title" data-frame-label={t('nav.work')}>
  <!-- «Синька»: сетка на слое фиксированной высоты (см. стили) -->
  <div class="work__bg" aria-hidden="true"></div>
  <div class="work__tear" aria-hidden="true"></div>
  <StickStation pose="laptop" class="lane-station" />

  <div class="container">
    <header class="work__head">
      <p class="eyebrow" data-reveal>{t('work.eyebrow')}</p>
      <h2 class="work__title" id="work-title" data-reveal data-write style="--reveal-i: 1">
        <span class="title-u">{t('work.title')}<Underline variant="double" perch="laptop" /></span>
      </h2>
      <p class="work__lead" data-reveal style="--reveal-i: 2">{t('work.lead')}</p>
      <p class="micro work__count" data-reveal style="--reveal-i: 3">({String(projects.length).padStart(2, '0')} {t('work.projects')} · {range})</p>
    </header>

    <ol class="work__list rule" role="list" data-work-list data-perch="point" data-perch-at="0.97" data-perch-face="left">
      {
        projects.map((p, i) => (
          <li
            class="project rule"
            id={`work-${p.slug}`}
            data-perch={(['point', 'stand', 'wave', 'point', 'stand', 'wave'] as const)[i % 6]}
            data-perch-at={[0.9, 0.55, 0.75, 0.35, 0.92, 0.6][i % 6]}
            data-perch-face={i % 2 ? 'right' : 'left'}
            data-project={p.slug}
            data-reveal
            style={`--reveal-i: ${i % 3}; --tilt: ${tilts[i % tilts.length]}deg`}
          >
            <h3 class="project__heading">
              <button
                type="button"
                class="project__row"
                aria-expanded="false"
                aria-controls={`panel-${p.slug}`}
                id={`btn-${p.slug}`}
                data-cursor={t('work.open')}
                data-label-open={t('work.open')}
                data-label-close={t('work.close')}
              >
                <span class="project__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="project__name">{p.title}</span>
                <span class="project__tagline">{pick(p.tagline, lang)}</span>
                <span class="project__year">{p.year}</span>
                <span class="project__plus" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <path d="M12.4 3.5c-.3 5.6.2 11.4-.6 17" class="plus-v"></path>
                    <path d="M3.6 12.2c5.4-.6 11.4.3 16.9-.5"></path>
                  </svg>
                </span>
              </button>
            </h3>

            <div
              class="project__panel"
              id={`panel-${p.slug}`}
              role="region"
              aria-labelledby={`btn-${p.slug}`}
              data-panel
            >
              <div class="project__panel-inner">
                <div class="project__body">
                  <div class="project__photo paper taped">
                    <ProjectVisual project={p} class="project__visual" />
                    <p class="project__caption">{p.title}, {p.year}</p>
                  </div>
                  <div class="project__info">
                    <p class="project__summary">{pick(p.summary, lang)}</p>

                    <dl class="project__facts">
                      <div>
                        <dt>{t('work.role')}</dt>
                        <dd>{p.solo ? t('work.solo') : t('work.team')}</dd>
                      </div>
                      <div>
                        <dt>{t('work.year')}</dt>
                        <dd>{p.year}</dd>
                      </div>
                      <div class="project__stack">
                        <dt>{t('work.stack')}</dt>
                        <dd>
                          <ul role="list">
                            {p.stack.map((s) => (
                              <li>{s}</li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                    </dl>

                    {p.highlight && (
                      <aside class="project__highlight paper">
                        <p class="project__highlight-label">{t('work.highlight')}</p>
                        <p>{pick(p.highlight, lang)}</p>
                      </aside>
                    )}

                    {p.links && p.links.length > 0 && (
                      <ul class="project__links" role="list">
                        {p.links.map((l) => (
                          <li>
                            <a class="btn" href={l.href} target="_blank" rel="noopener">
                              {l.label} ↗
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Полароид за курсором (только мышь) -->
  <div class="work__preview paper taped" aria-hidden="true" data-preview>
    {projects.map((p) => <ProjectVisual project={p} class="work__preview-item" />)}
  </div>
</section>

<style>
  /* Секция во всю ширину, включая поля тетради */
  .work {
    outline: none;
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-left: calc(var(--lane) * -1);
    padding-left: var(--lane);
    color: var(--color-text);
  }

  /* Сетка чертежа. Высота слоя фиксированная и с запасом: когда аккордеон
     меняет высоту секции, слой не перерисовывается — меняется только обрезка.
     Верхний край оторван (clip-path на статичном слое). */
  .work__bg {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 4200px;
    min-height: 100%;
    background:
      linear-gradient(var(--color-grid-strong) 1px, transparent 1px) 0 -1px / 100% 140px,
      linear-gradient(90deg, var(--color-grid-strong) 1px, transparent 1px) -1px 0 / 140px 100%,
      linear-gradient(var(--color-grid) 1px, transparent 1px) 0 -1px / 100% 28px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) -1px 0 / 28px 100%,
      var(--color-bg);
    clip-path: polygon(
      0 14px, 3% 5px, 8% 15px, 13% 3px, 19% 12px, 25% 4px, 31% 14px, 38% 6px, 44% 15px, 51% 3px,
      57% 12px, 63% 4px, 70% 14px, 76% 5px, 82% 15px, 88% 3px, 94% 12px, 100% 5px, 100% 100%, 0 100%
    );
    will-change: transform;
  }
  /* Нижний оторванный край: полоска бумаги листа поверх синьки */
  .work__tear {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 16px;
    background: var(--p-bg);
    clip-path: polygon(
      0 100%, 0 45%, 4% 10%, 9% 55%, 15% 0, 21% 50%, 27% 12%, 33% 60%, 40% 20%, 46% 65%, 52% 5%,
      58% 50%, 64% 0, 71% 55%, 77% 15%, 83% 62%, 89% 8%, 95% 50%, 100% 18%, 100% 100%
    );
  }

  /* секция начинается от края экрана, а не от полей */
  .work {
    --station-top: calc(var(--section-space) + 2rem);
  }
  @media (min-width: 900px) {
    .work > :global(.lane-station) {
      left: calc(var(--lane) * 0.5);
    }
  }

  .work__count {
    color: var(--color-text);
  }

  .work__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .work__title {
    font-size: var(--step-4);
  }

  .work__lead {
    max-width: 46ch;
    color: var(--color-muted);
  }

  /* верхняя линия списка */
  .work__list::after {
    top: -4px;
    bottom: auto;
  }

  /* Свой слой у каждой строки: когда соседний проект раскрывается,
     строки ниже двигаются как готовые слои, без перерисовки каждый кадр */
  .project {
    will-change: transform;
  }

  .project__heading {
    font: inherit;
    /* обрезаем выезжающую штриховку по бокам (по вертикали — нет, чтобы не резать фокус) */
    overflow-x: clip;
    margin-inline: -0.6rem;
    padding-inline: 0.6rem;
  }

  .project__row {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1.1fr) minmax(0, 1.4fr) 3.5rem 2rem;
    align-items: center;
    gap: 1rem;
    padding: clamp(1rem, 2vw, 1.6rem) 0;
    text-align: left;
    isolation: isolate;
  }

  /* Штриховка маркером при наведении. Рисуется один раз в своём слое и
     выезжает трансформом: анимация clip-path перерисовывала бы
     repeating-gradient на всю ширину каждый кадр (это и тормозило). */
  .project__row::before {
    content: '';
    position: absolute;
    inset: 6px -0.6rem;
    z-index: -1;
    border-radius: var(--wobble);
    background: repeating-linear-gradient(
      -35deg,
      color-mix(in oklch, var(--color-highlight) 90%, transparent) 0 3px,
      transparent 3px 8px
    );
    transform: translateX(-101%);
    transition: transform 0.45s var(--ease-out);
    will-change: transform;
  }
  .project__row:hover::before,
  .project__row[aria-expanded='true']::before {
    transform: none;
  }

  .project__num {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .project__year {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    color: var(--color-muted);
  }

  .project__name {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1;
    transform-origin: left center;
    transition:
      transform 0.5s var(--ease-back),
      color 0.3s;
  }
  .project__row:hover .project__name {
    transform: translateX(0.4rem) rotate(-2deg);
    color: var(--color-accent);
  }

  .project__tagline {
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .project__plus {
    justify-self: end;
    transition: transform 0.5s var(--ease-back);
  }
  .project__plus svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .plus-v {
    transform-origin: 12px 12px;
    transition: transform 0.45s var(--ease-back);
  }
  [aria-expanded='true'] .project__plus {
    transform: rotate(-8deg);
  }
  [aria-expanded='true'] .plus-v {
    transform: scaleY(0);
  }

  /* --- Панель: анимация высоты через grid 0fr → 1fr --- */
  .project__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-in-out);
  }
  .project.is-open .project__panel {
    grid-template-rows: 1fr;
  }
  .project__panel-inner {
    overflow: hidden;
    min-height: 0;
  }
  /* Без JS всё раскрыто */
  :global(html:not(.js)) .project__panel {
    grid-template-rows: 1fr;
  }

  .project__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: 1.6rem 0.4rem clamp(2rem, 4vw, 3rem) 3.6rem;
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.5s, transform 0.7s var(--ease-out);
  }
  .project.is-open .project__body,
  :global(html:not(.js)) .project__body {
    opacity: 1;
    transform: none;
    transition-delay: 0.15s;
  }

  /* Полароид */
  .project__photo {
    align-self: start;
    padding: 0.8rem 0.8rem 0.4rem;
    transition: rotate 0.6s var(--ease-back);
  }
  .project.is-open .project__photo {
    rotate: var(--tilt);
  }
  .project__photo:hover {
    rotate: 0deg !important;
  }
  .project__caption {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    font-weight: 600;
    text-align: center;
    padding-top: 0.3rem;
    color: var(--color-muted);
  }

  .project__info {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .project__summary {
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .project__facts {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 1rem 2.5rem;
    font-size: var(--step--1);
  }
  .project__facts dt {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.35rem;
  }
  .project__facts dd {
    margin: 0;
    font-weight: 600;
  }
  .project__stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .project__stack li {
    padding: 0.1em 0.65em;
    border: 1.5px solid var(--color-text);
    border-radius: var(--wobble);
  }
  .project__stack li:nth-child(odd) {
    rotate: -1.5deg;
  }
  .project__stack li:nth-child(3n) {
    rotate: 1.2deg;
  }

  /* «А вы знали?» — жёлтый стикер */
  .project__highlight {
    --tilt: 1.2deg;
    padding: 1rem 1.2rem 1.1rem;
    background: color-mix(in oklch, var(--p-highlight) 55%, var(--color-surface));
    color: var(--p-ink);
    font-size: var(--step--1);
    font-weight: 600;
  }
  :global([data-theme='night']) .project__highlight {
    color: var(--color-bg);
  }
  .project__highlight-label {
    font-family: var(--font-hand);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* --- Полароид за курсором --- */
  .work__preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: clamp(13.75rem, 21vw, 20rem);
    padding: 0.65rem 0.65rem 2.2rem;
    pointer-events: none;
    opacity: 0;
    scale: 0.8;
    /* свой слой: движется за мышью только трансформом, без перерисовки */
    will-change: transform, opacity;
    transition:
      opacity 0.3s,
      scale 0.5s var(--ease-back);
    display: none;
  }
  .work__preview.is-visible {
    opacity: 1;
    scale: 1;
  }
  /* .is-near — секция близко (скрипт ниже). Раньше display: grid стоял сразу,
     и lazy-картинки превью (fixed в углу экрана, opacity 0) браузер считал
     видимыми: ~300 КБ грузились при открытии страницы, до любого наведения. */
  :global(html.has-cursor) .work.is-near .work__preview {
    display: grid;
  }
  .work__preview :global(.work__preview-item) {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .work__preview :global(.work__preview-item.is-current) {
    opacity: 1;
  }

  @media (max-width: 820px) {
    .project__row {
      grid-template-columns: 2rem 1fr 1.5rem;
      grid-template-areas:
        'num name plus'
        '. tag tag';
      row-gap: 0.3rem;
    }
    .project__num {
      grid-area: num;
    }
    .project__name {
      grid-area: name;
    }
    .project__tagline {
      grid-area: tag;
    }
    .project__plus {
      grid-area: plus;
    }
    .project__year {
      display: none;
    }
    .project__body {
      grid-template-columns: 1fr;
      padding-left: 0;
    }
    .project__facts {
      grid-template-columns: auto auto;
    }
    .project__stack {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../lib/motion';

  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
  const preview = document.querySelector<HTMLElement>('[data-preview]')!;
  const previewItems = Array.from(preview.querySelectorAll<HTMLElement>('.work__preview-item'));

  /* ---------- Аккордеон ---------- */
  function setOpen(item: HTMLElement, open: boolean) {
    const btn = item.querySelector<HTMLButtonElement>('.project__row')!;
    const panel = item.querySelector<HTMLElement>('[data-panel]')!;
    item.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.dataset.cursor = open ? btn.dataset.labelClose : btn.dataset.labelOpen;
    panel.inert = !open;
    // высота страницы меняется — пересчитать триггеры после перехода
    panel.addEventListener('transitionend', () => ScrollTrigger.refresh(), { once: true });
  }

  items.forEach((item) => {
    setOpen(item, false);
    item.querySelector('.project__row')!.addEventListener('click', () => {
      const willOpen = !item.classList.contains('is-open');
      items.forEach((other) => other !== item && other.classList.contains('is-open') && setOpen(other, false));
      setOpen(item, willOpen);
    });
  });

  // Ссылка вида #work-focal открывает нужный проект
  const fromHash = location.hash.startsWith('#work-') && items.find((i) => `#work-${i.dataset.project}` === location.hash);
  if (fromHash) setOpen(fromHash, true);

  /* ---------- Полароид за курсором ---------- */
  // Картинки превью начинают грузиться за полтора экрана до секции
  const work = document.querySelector<HTMLElement>('#work')!;
  if ('IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        work.classList.add('is-near');
        near.disconnect();
      },
      { rootMargin: '150% 0px' },
    );
    near.observe(work);
  } else work.classList.add('is-near');

  const xTo = gsap.quickTo(preview, 'x', { duration: 0.6, ease: 'power3.out' });
  const yTo = gsap.quickTo(preview, 'y', { duration: 0.6, ease: 'power3.out' });
  const rotTo = gsap.quickTo(preview, 'rotate', { duration: 0.8, ease: 'power3.out' });
  let lastX = 0;

  const list = document.querySelector<HTMLElement>('[data-work-list]')!;
  list.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    xTo(e.clientX + 36);
    yTo(e.clientY - preview.offsetHeight / 2);
    rotTo(gsap.utils.clamp(-10, 10, (e.clientX - lastX) * 0.7 + 3));
    lastX = e.clientX;
  });

  items.forEach((item, i) => {
    const row = item.querySelector<HTMLElement>('.project__row')!;
    row.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || item.classList.contains('is-open')) return;
      if (!preview.classList.contains('is-visible')) {
        gsap.set(preview, { x: e.clientX + 36, y: e.clientY - preview.offsetHeight / 2 });
      }
      previewItems.forEach((p, n) => p.classList.toggle('is-current', n === i));
      preview.classList.add('is-visible');
    });
    row.addEventListener('pointerleave', () => preview.classList.remove('is-visible'));
    row.addEventListener('click', () => preview.classList.remove('is-visible'));
  });
</script>
