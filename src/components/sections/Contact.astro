---
import { useT, type Lang } from '../../i18n';
import { profile } from '../../data/profile';
import Star from '../sketch/Star.astro';
import StickStation from '../sketch/StickStation.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const [user, domain] = profile.email.split('@');
---

<section class="contact section" id="contact" tabindex="-1" aria-labelledby="contact-title" data-frame-label={t('nav.contact')}>
  <StickStation pose="plane" class="lane-station" />
  <div class="container">
    <div
      class="contact__sheet paper taped"
      data-reveal
      style="--reveal-rot: -2deg"
      data-perch="plane"
      data-perch-at="0.86"
      data-perch-face="left"
    >
      <Star variant="both" class="contact__star" />
      <p class="eyebrow">{t('contact.eyebrow')}</p>
      <h2 class="contact__title" id="contact-title" data-write>{t('contact.title')}</h2>
      <p class="contact__lead">{t('contact.lead')}</p>

      <div class="contact__mail">
        <a class="contact__email" href={`mailto:${profile.email}`} data-cursor="Mail" data-plane-target>
          <span>{user}</span><span class="contact__at">@</span><span>{domain}</span>
          <svg class="contact__email-line" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" d="M3 12c40-6 90-8 140-4s100 4 154-2"></path>
          </svg>
        </a>
        <button type="button" class="btn" data-copy={profile.email} data-magnetic="0.25">
          {t('contact.copy')}
        </button>
      </div>

      <ul class="contact__links" role="list" data-perch="point" data-perch-at="0.98" data-perch-face="left">
        {
          profile.links.map((l) => (
            <li>
              <a class="btn" href={l.href} target="_blank" rel="noopener" data-magnetic="0.25">
                {l.label} ↗
              </a>
            </li>
          ))
        }
        <li>
          <a class="btn btn--solid" href={profile.cv} download data-magnetic="0.25">{t('contact.cv')} ↓</a>
        </li>
      </ul>
    </div>
  </div>

  <p class="toast paper" role="status" aria-live="polite" data-toast data-text={t('contact.copied')}></p>
</section>

<style>
  .contact {
    outline: none;
    min-height: 90svh;
    display: grid;
    align-items: center;
    --station-top: calc(var(--section-space) + 9rem);
  }

  /* Свой слой (на .container, а не на секции: внутри секции fixed-тост,
     а will-change: transform сломал бы ему позиционирование) */
  .contact > :global(.container) {
    will-change: transform;
  }

  /* Лист в линейку */
  .contact__sheet {
    --tilt: -0.6deg;
    display: grid;
    gap: 1.2rem;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1.4rem, 5vw, 4.5rem);
    background:
      repeating-linear-gradient(
        transparent 0 calc(2.2rem - 1px),
        color-mix(in oklch, var(--color-line) 55%, transparent) calc(2.2rem - 1px) 2.2rem
      )
      0 1.2rem,
      var(--color-surface);
  }

  /* Звезда-штамп у края листа не должна расширять страницу на телефоне.
     Только там: на десктопе слева от секции в полях стоит станция стикмена. */
  @media (max-width: 899px) {
    .contact {
      overflow-x: clip;
    }
  }

  /* Звезда-штамп в углу листа */
  .contact__sheet :global(.contact__star) {
    position: absolute;
    right: clamp(-1.5rem, -2vw, -0.5rem);
    top: clamp(-2.5rem, -3vw, -1.5rem);
    width: clamp(5rem, 11vw, 9rem);
    color: var(--color-text);
    --star-fill: var(--color-accent);
    --star-stroke: 2.4;
    rotate: 14deg;
    transition: rotate 0.8s var(--ease-back);
  }
  .contact__sheet:hover :global(.contact__star) {
    rotate: 104deg;
  }

  .contact__title {
    /* на низких экранах (телефон в ландшафте) не на весь экран */
    font-size: min(var(--step-5), 24svh);
    line-height: 0.9;
    max-width: 14ch;
  }

  .contact__lead {
    color: var(--color-muted);
    font-weight: 600;
    max-width: 44ch;
  }

  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .contact__email {
    position: relative;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.9rem, 1.2rem + 3.6vw, 4.4rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
    transition: rotate 0.5s var(--ease-back);
  }
  .contact__at {
    color: var(--color-accent);
    display: inline-block;
    transition: rotate 0.6s var(--ease-back);
  }
  .contact__email:hover .contact__at {
    rotate: 360deg;
  }
  .contact__email-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.3em;
    overflow: visible;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .contact__email-line path {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.01;
    transition: stroke-dashoffset 0.6s var(--ease-out);
  }
  .contact__email:hover .contact__email-line path,
  .contact__email:focus-visible .contact__email-line path,
  :global(.is-hit) .contact__email-line path {
    stroke-dashoffset: 0;
  }
  /* самолётик стикмена попал в адрес */
  :global(.is-hit).contact__email {
    animation: hit 0.6s var(--ease-back);
  }
  @keyframes hit {
    30% {
      rotate: -3deg;
      scale: 1.04;
    }
    60% {
      rotate: 2deg;
    }
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.8rem;
    margin-top: 0.6rem;
  }

  .toast {
    --tilt: -2deg;
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: 200;
    padding: 0.4rem 1.2rem 0.5rem;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    font-weight: 700;
    translate: -50% 160%;
    opacity: 0;
    transition:
      translate 0.5s var(--ease-back),
      opacity 0.3s;
    pointer-events: none;
  }
  .toast.is-visible {
    translate: -50% 0;
    opacity: 1;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  let timer = 0;

  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
    } catch {
      return; // буфер обмена недоступен — ссылка mailto всё равно рядом
    }
    toast.textContent = toast.dataset.text ?? '';
    toast.classList.add('is-visible');
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove('is-visible'), 2200);
  });
</script>
