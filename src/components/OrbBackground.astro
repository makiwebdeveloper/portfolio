---
/**
 * Фон с мягкими переливающимися орбами (OGL, один фрагментный шейдер).
 * Пока WebGL не загрузился (или недоступен) — CSS-градиент тех же цветов.
 */
---

<div class="orbs" data-orbs aria-hidden="true">
  <canvas class="orbs__canvas"></canvas>
</div>

<style>
  .orbs {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(40vmax 40vmax at 20% 25%, color-mix(in oklch, var(--p-orb-1), var(--color-bg) calc(var(--scene) * 70%)), transparent 70%),
      radial-gradient(38vmax 38vmax at 85% 30%, color-mix(in oklch, var(--p-orb-2), var(--color-bg) calc(var(--scene) * 70%)), transparent 70%),
      radial-gradient(45vmax 45vmax at 55% 95%, color-mix(in oklch, var(--p-orb-3), var(--color-bg) calc(var(--scene) * 70%)), transparent 70%),
      var(--color-bg);
  }

  .orbs__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .orbs.is-ready .orbs__canvas {
    opacity: 1;
  }
</style>

<script>
  import { reducedMotion } from '../lib/motion';
  import { getScene, onScene, readToken } from '../lib/theme';

  const host = document.querySelector<HTMLElement>('[data-orbs]')!;
  const canvas = host.querySelector('canvas')!;

  const vertex = /* glsl */ `
    attribute vec2 position;
    attribute vec2 uv;
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  const fragment = /* glsl */ `
    precision mediump float;
    varying vec2 vUv;
    uniform float uTime;
    uniform float uAspect;
    uniform float uScene;
    uniform vec2 uMouse;
    uniform vec3 uBg;
    uniform vec3 uInv;
    uniform vec3 uO1;
    uniform vec3 uO2;
    uniform vec3 uO3;

    float blob(vec2 p, vec2 c, float r) {
      float d = length(p - c);
      return 1.0 - smoothstep(0.0, r, d);
    }

    void main() {
      vec2 p = vec2(vUv.x * uAspect, vUv.y);
      float t = uTime * 0.05;

      // орбы медленно плавают по кривым Лиссажу
      vec2 c1 = vec2(uAspect * (0.22 + 0.12 * sin(t * 1.3)), 0.74 + 0.10 * cos(t * 1.1));
      vec2 c2 = vec2(uAspect * (0.82 + 0.10 * cos(t * 0.9)), 0.68 + 0.14 * sin(t * 1.4));
      vec2 c3 = vec2(uAspect * (0.55 + 0.18 * sin(t * 0.7)), 0.12 + 0.12 * cos(t * 1.2));
      // четвёртый орб тянется к курсору
      vec2 c4 = vec2(uMouse.x * uAspect, uMouse.y);

      // мягкое искажение пространства, чтобы края «дышали»
      p += 0.035 * vec2(sin(p.y * 4.0 + t * 3.0), cos(p.x * 3.5 - t * 2.5));

      vec3 bg = mix(uBg, uInv, uScene);
      float dim = 1.0 - uScene * 0.45;
      vec3 o1 = mix(bg, uO1, dim);
      vec3 o2 = mix(bg, uO2, dim);
      vec3 o3 = mix(bg, uO3, dim);

      vec3 col = bg;
      col = mix(col, o1, blob(p, c1, 0.85));
      col = mix(col, o2, blob(p, c2, 0.75) * 0.95);
      col = mix(col, o3, blob(p, c3, 0.90) * 0.95);
      col = mix(col, mix(o1, o2, 0.5), blob(p, c4, 0.45) * 0.35);

      // лёгкое зерно против бандинга градиентов
      float n = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
      col += (n - 0.5) * 0.012;

      gl_FragColor = vec4(col, 1.0);
    }
  `;

  async function start() {
    const { Renderer, Program, Mesh, Triangle, Vec2 } = await import('ogl');

    // Низкое разрешение: при таком размытии разница не видна, а GPU в 4–6 раз меньше работы.
    let quality = 0.5;
    const dpr = () => Math.min(window.devicePixelRatio || 1, 1.5) * quality;

    let renderer: InstanceType<typeof Renderer>;
    try {
      renderer = new Renderer({
        canvas,
        dpr: dpr(),
        alpha: false,
        antialias: false,
        depth: false,
        powerPreference: 'low-power',
      });
    } catch {
      return; // WebGL недоступен — остаётся CSS-градиент
    }
    const gl = renderer.gl;

    const program = new Program(gl, {
      vertex,
      fragment,
      uniforms: {
        uTime: { value: Math.random() * 100 },
        uAspect: { value: 1 },
        uScene: { value: getScene() },
        uMouse: { value: new Vec2(0.5, 0.5) },
        uBg: { value: readToken('--p-bg') },
        uInv: { value: readToken('--p-invert-bg') },
        uO1: { value: readToken('--p-orb-1') },
        uO2: { value: readToken('--p-orb-2') },
        uO3: { value: readToken('--p-orb-3') },
      },
    });
    const mesh = new Mesh(gl, { geometry: new Triangle(gl), program });
    const u = program.uniforms;

    const resize = () => {
      renderer.dpr = dpr();
      renderer.setSize(window.innerWidth, window.innerHeight);
      u.uAspect.value = window.innerWidth / window.innerHeight;
    };
    resize();

    let needsFrame = true;
    const render = () => {
      renderer.render({ scene: mesh });
      needsFrame = false;
    };

    // Цвета: перечитываем токены при смене темы/палитры.
    window.addEventListener('colorschange', () => {
      u.uBg.value = readToken('--p-bg');
      u.uInv.value = readToken('--p-invert-bg');
      u.uO1.value = readToken('--p-orb-1');
      u.uO2.value = readToken('--p-orb-2');
      u.uO3.value = readToken('--p-orb-3');
      needsFrame = true;
    });
    onScene((v) => {
      u.uScene.value = v;
      needsFrame = true;
    });

    // Курсор: цель + плавное догоняние в цикле.
    const mouseTarget = { x: 0.5, y: 0.5 };
    window.addEventListener(
      'pointermove',
      (e) => {
        mouseTarget.x = e.clientX / window.innerWidth;
        mouseTarget.y = 1 - e.clientY / window.innerHeight;
      },
      { passive: true },
    );

    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => {
        resize();
        needsFrame = true;
      });
    });

    // ---- Цикл: ~40 fps максимум, пауза когда вкладка скрыта или пользователь выключил ----
    let paused = reducedMotion.matches;
    let raf = 0;
    let last = performance.now();
    let acc = 0;
    let slowFrames = 0;
    const FRAME = 1000 / 40;

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      const dt = now - last;
      last = now;

      if (paused) {
        if (needsFrame) render();
        return;
      }

      acc += dt;
      if (acc < FRAME) return;

      // Адаптация: если кадры стабильно медленные — снижаем разрешение.
      if (acc > 34) slowFrames++;
      else slowFrames = Math.max(0, slowFrames - 1);
      if (slowFrames > 45 && quality > 0.3) {
        quality -= 0.1;
        slowFrames = 0;
        resize();
      }

      u.uTime.value += Math.min(acc, 100) / 1000;
      acc = 0;
      const m = u.uMouse.value;
      m.x += (mouseTarget.x - m.x) * 0.05;
      m.y += (mouseTarget.y - m.y) * 0.05;
      render();
    };

    const setRunning = (run: boolean) => {
      cancelAnimationFrame(raf);
      if (run) {
        last = performance.now();
        raf = requestAnimationFrame(loop);
      }
    };

    document.addEventListener('visibilitychange', () => setRunning(!document.hidden));
    reducedMotion.addEventListener('change', () => {
      paused = reducedMotion.matches;
      needsFrame = true;
      emitState();
    });

    // Кнопка Play/Pause в шапке
    const emitState = () =>
      window.dispatchEvent(new CustomEvent('orbs:state', { detail: { paused } }));
    window.addEventListener('orbs:toggle', () => {
      paused = !paused;
      needsFrame = true;
      emitState();
    });

    render();
    setRunning(true);
    host.classList.add('is-ready');
    emitState();
  }

  // Не мешаем первой отрисовке: стартуем, когда браузер свободен.
  const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 300));
  idle(() => void start(), { timeout: 2000 });
</script>
