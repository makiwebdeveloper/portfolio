---
/**
 * Разделитель между секциями: звёздочка, цепочка пузырьков и волнистая линия.
 * При появлении (initReveals → .is-in) звёздочка прокатывается вдоль линии,
 * пузырьки «надуваются» по очереди. Всё — transform/opacity.
 */
import Star from './Star.astro';

interface Props {
  /** Зеркально: звёздочка катится справа налево. */
  flip?: boolean;
}
const { flip = false } = Astro.props;
const bubbles = [0.55, 0.85, 0.45, 1, 0.6, 0.9, 0.5];
---

<div class:list={['divider container', { 'divider--flip': flip }]} data-reveal aria-hidden="true">
  <span class="divider__bubbles">
    {bubbles.map((s, i) => <span style={`--s: ${s}; --i: ${i}`} />)}
  </span>
  <span class="divider__line"></span>
  <span class="divider__roller">
    <Star variant="both" class="divider__star" />
  </span>
</div>

<style>
  .divider {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 2.4rem;
    color: var(--color-text);
    /* у reveal свой наклон: тут он не нужен */
    --reveal-rot: 0deg;
  }
  .divider--flip {
    flex-direction: row-reverse;
  }

  .divider__bubbles {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-left: 2.6rem;
  }
  .divider--flip .divider__bubbles {
    padding: 0 2.6rem 0 0;
    flex-direction: row-reverse;
  }
  .divider__bubbles span {
    width: calc(0.7rem * var(--s));
    aspect-ratio: 1;
    border: 1.5px solid currentColor;
    border-radius: 52% 48% 46% 54% / 55% 45% 55% 45%;
    opacity: 0.7;
    transform: scale(0);
    transition: transform 0.5s var(--ease-back);
    transition-delay: calc(0.35s + var(--i) * 0.07s);
  }
  .divider.is-in .divider__bubbles span,
  :global(html:not(.js)) .divider__bubbles span {
    transform: none;
  }

  .divider__line {
    flex: 1;
    height: 8px;
    background: var(--color-line);
    -webkit-mask: var(--wavy-line) 0 50% / 420px 8px repeat-x;
    mask: var(--wavy-line) 0 50% / 420px 8px repeat-x;
  }

  /* Звёздочка стартует у края и докатывается до начала пузырьков */
  .divider__roller {
    position: absolute;
    left: 0;
    top: 50%;
    width: 2rem;
    height: 2rem;
    margin-top: -1rem;
    --star-fill: var(--color-bg);
    --star-stroke: 5;
    transform: translateX(min(40vw, 22rem)) rotate(200deg) scale(0.4);
    opacity: 0;
    transition:
      transform 1.1s var(--ease-out),
      opacity 0.4s;
  }
  .divider--flip .divider__roller {
    left: auto;
    right: 0;
    transform: translateX(max(-40vw, -22rem)) rotate(-200deg) scale(0.4);
  }
  .divider.is-in .divider__roller,
  :global(html:not(.js)) .divider__roller {
    transform: none;
    opacity: 1;
  }
  .divider__roller :global(.divider__star) {
    width: 100%;
    height: 100%;
  }
</style>
