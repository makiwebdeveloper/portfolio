---
import { languages, pathFor, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const links = [
  { id: 'story', label: t('nav.story') },
  { id: 'work', label: t('nav.work') },
  { id: 'skills', label: t('nav.skills') },
  { id: 'contact', label: t('nav.contact') },
];
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__logo sketch" href="#top" aria-label={t('nav.home')} data-scroll-link>
      <span class="nav__mono">IM</span>
    </a>

    <nav class="nav__links" aria-label={t('nav.label')}>
      <ul role="list">
        {
          links.map((l, i) => (
            <li>
              <a href={`#${l.id}`} data-scroll-link data-nav-link={l.id}>
                <span class="nav__num">0{i + 1}</span>
                {l.label}
                <svg class="nav__squiggle" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
                  <path pathLength="1" d="M2 6c10-5 18 3 28 0s18-5 28-1 20 3 30-1 8-2 10-1"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__tools">
      <div class="nav__langs" role="group" aria-label={t('lang.label')}>
        {
          (Object.keys(languages) as Lang[]).map((l) => (
            <a
              href={pathFor(l)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              data-lang-link
              data-astro-prefetch="hover"
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>

      <button
        class="nav__icon"
        type="button"
        data-still-toggle
        aria-pressed="false"
        data-label-pause={t('bg.pause')}
        data-label-play={t('bg.play')}
        aria-label={t('bg.pause')}
      >
        <svg viewBox="0 0 20 20" width="20" height="20" class="i-pause" aria-hidden="true"><path d="M7 4.5c.2 3.6-.2 7.4.3 11M13 4c-.3 4 .3 7.6-.2 11.5"></path></svg>
        <svg viewBox="0 0 20 20" width="20" height="20" class="i-play" aria-hidden="true"><path d="M6.5 4.2c-.3 4 .2 8 .1 11.6 3-1.8 6.4-3.6 8.6-5.9-2.6-1.9-5.6-3.8-8.7-5.7z"></path></svg>
      </button>

      <button
        class="nav__icon nav__theme"
        type="button"
        data-theme-toggle
        aria-label={t('theme.toggle')}
        data-day={t('theme.day')}
        data-night={t('theme.night')}
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <!-- солнце: кружок от руки + лучи; луна: серп -->
          <path class="theme__sun" d="M16.6 11.2c.4 2.9-1.8 5.4-4.7 5.5-2.8.1-4.9-2-4.8-4.7.1-2.6 2.2-4.7 4.8-4.6 2.4.1 4.4 1.8 4.9 4.3"></path>
          <path class="theme__rays" d="M12 1.8v2.6M12.2 19.8v2.5M1.8 12.1h2.6M19.7 11.9h2.5M4.8 4.6l1.7 1.9M17.4 17.5l1.9 1.8M4.6 19.3l1.9-1.7M17.6 6.5l1.7-1.9"></path>
          <path class="theme__moon" d="M15.8 3.6c-4.9.3-8.6 4.3-8.2 9.1.4 4.4 4.3 7.8 8.9 7.4-5.6 2.7-12-1.4-12.1-7.8-.1-5.8 5.6-10.2 11.4-8.7z"></path>
        </svg>
      </button>

      <button
        class="nav__menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-btn
        data-open={t('nav.menu')}
        data-close={t('nav.close')}
      >
        <span class="nav__menu-text">{t('nav.menu')}</span>
        <span class="nav__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mmenu" id="mobile-menu" data-menu hidden>
    <nav aria-label={t('nav.label')}>
      <ul role="list">
        {
          links.map((l, i) => (
            <li>
              <a href={`#${l.id}`} data-scroll-link>
                <span class="nav__num">0{i + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: transform 0.5s var(--ease-out);
  }

  .nav.is-hidden:not(.is-open) {
    transform: translateY(-130%);
  }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem var(--gutter) 0.9rem;
    position: relative;
    z-index: 2;
  }

  /* полоска бумаги с рваным нижним краем, когда страница прокручена */
  .nav__bar::before {
    content: '';
    position: absolute;
    inset: 0 0 -10px;
    background: var(--color-surface);
    box-shadow: 0 6px 14px -10px var(--color-shadow);
    clip-path: polygon(
      0 0, 100% 0, 100% 86%, 96% 92%, 91% 85%, 85% 93%, 79% 87%, 72% 94%, 66% 86%, 59% 92%,
      53% 85%, 46% 93%, 40% 86%, 33% 92%, 27% 85%, 20% 93%, 14% 86%, 8% 92%, 3% 86%, 0 91%
    );
    opacity: 0;
    translate: 0 -12px;
    transition: opacity 0.35s, translate 0.45s var(--ease-out);
    z-index: -1;
  }
  .nav.is-scrolled .nav__bar::before {
    opacity: 1;
    translate: 0 0;
  }
  .nav.is-open .nav__bar::before {
    opacity: 0;
  }

  .nav__logo {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    rotate: -6deg;
    transition: rotate 0.5s var(--ease-back);
  }
  .nav__logo::before {
    border-radius: 52% 48% 46% 54% / 55% 45% 55% 45%;
    animation-name: boil-round;
  }
  .nav__logo:hover {
    rotate: 8deg;
  }

  .nav__links ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.4rem);
  }

  .nav__links a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    font-family: var(--font-hand);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.1;
    padding-block: 0.2rem 0.4rem;
  }

  .nav__squiggle {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: -0.1rem;
    width: 104%;
    height: 0.5rem;
    overflow: visible;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .nav__squiggle path {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.01;
    transition: stroke-dashoffset 0.45s var(--ease-out);
  }
  .nav__links a:hover .nav__squiggle path,
  .nav__links a.is-active .nav__squiggle path {
    stroke-dashoffset: 0;
  }

  .nav__num {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    translate: 0 -0.5em;
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav__langs {
    display: flex;
    gap: 0.15rem;
    margin-right: 0.3rem;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .nav__langs a {
    position: relative;
    padding: 0.1rem 0.45rem 0.2rem;
    color: var(--color-muted);
    transition: color 0.2s;
  }
  .nav__langs a:hover {
    color: var(--color-text);
  }
  /* текущий язык обведён от руки */
  .nav__langs a[aria-current] {
    color: var(--color-text);
  }
  .nav__langs a[aria-current]::before {
    content: '';
    position: absolute;
    inset: 0 -0.05rem;
    border: 2px solid var(--color-accent);
    border-radius: 50% 45% 55% 48% / 55% 50% 48% 45%;
    rotate: -6deg;
  }

  .nav__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    transition: rotate 0.5s var(--ease-back);
  }
  .nav__icon:hover {
    rotate: -12deg;
  }
  .nav__icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .i-play {
    display: none;
  }
  [aria-pressed='true'] .i-play {
    display: block;
  }
  [aria-pressed='true'] .i-pause {
    display: none;
  }

  /* Солнце ↔ луна */
  .theme__sun,
  .theme__rays,
  .theme__moon {
    transition:
      transform 0.6s var(--ease-back),
      opacity 0.35s;
    transform-origin: 12px 12px;
  }
  .theme__moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.5);
  }
  :global([data-theme='night']) .theme__sun,
  :global([data-theme='night']) .theme__rays {
    opacity: 0;
    transform: rotate(60deg) scale(0.5);
  }
  :global([data-theme='night']) .theme__moon {
    opacity: 1;
    transform: none;
  }

  /* --- Мобильное меню --- */
  .nav__menu-btn {
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.4rem 0.4rem 0.8rem;
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 600;
  }

  .nav__burger {
    display: grid;
    gap: 6px;
    width: 24px;
  }
  .nav__burger span {
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }
  .nav__burger span:first-child {
    rotate: -3deg;
  }
  .nav__burger span:last-child {
    rotate: 2deg;
    width: 80%;
  }
  .nav.is-open .nav__burger span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .nav.is-open .nav__burger span:last-child {
    transform: translateY(-4px) rotate(-45deg);
    width: 100%;
  }

  .mmenu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    align-items: center;
    padding: 6rem var(--gutter) 3rem;
    background: var(--color-bg);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-in-out);
  }
  .mmenu[hidden] {
    display: none;
  }
  .nav.is-open .mmenu {
    clip-path: inset(0 0 0 0);
  }
  .mmenu ul {
    display: grid;
    gap: 0.4rem;
  }
  .mmenu a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .mmenu .nav__squiggle {
    display: none;
  }
  .mmenu li {
    opacity: 0;
    transform: translateY(1.5rem) rotate(2deg);
    transition: opacity 0.5s, transform 0.6s var(--ease-back);
  }
  .mmenu li:nth-child(even) a {
    padding-left: 1.5rem;
  }
  .nav.is-open .mmenu li {
    opacity: 1;
    transform: none;
  }
  .nav.is-open .mmenu li:nth-child(2) { transition-delay: 0.06s; }
  .nav.is-open .mmenu li:nth-child(3) { transition-delay: 0.12s; }
  .nav.is-open .mmenu li:nth-child(4) { transition-delay: 0.18s; }

  @media (max-width: 820px) {
    .nav__links {
      display: none;
    }
    .nav__menu-btn {
      display: inline-flex;
    }
    .nav__langs {
      margin-right: 0;
    }
  }

  @media (max-width: 420px) {
    .nav__menu-text {
      display: none;
    }
    .nav__icon {
      width: 2.2rem;
    }
  }

  /* Самые узкие телефоны (320–360): всё в одну строку без касаний */
  @media (max-width: 360px) {
    .nav__bar {
      gap: 0.5rem;
    }
    .nav__logo {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.25rem;
    }
    .nav__langs a {
      padding-inline: 0.3rem;
    }
    .nav__icon {
      width: 1.9rem;
    }
  }
</style>

<script>
  import { lockScroll, scrollToTarget } from '../lib/motion';
  import { getTheme, setTheme } from '../lib/theme';
  import { rememberSpot } from '../lib/relang';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const menu = nav.querySelector<HTMLElement>('[data-menu]')!;
  const menuBtn = nav.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menuText = menuBtn.querySelector<HTMLElement>('.nav__menu-text')!;

  /* ---------- Плавные якоря ---------- */
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!a) return;
    const id = a.getAttribute('href')!;
    const target = id === '#top' ? 0 : document.querySelector<HTMLElement>(id);
    if (target === null) return;
    e.preventDefault();
    if (nav.classList.contains('is-open')) setMenu(false);
    scrollToTarget(target);
    history.replaceState(null, '', id === '#top' ? location.pathname : id);
    // переводим фокус в секцию для клавиатуры и скринридеров
    if (target instanceof HTMLElement) target.focus({ preventScroll: true });
  });

  /* ---------- Смена языка: запомнить место, новая страница встанет туда же ---------- */
  nav.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return; // новая вкладка
      if (a.hasAttribute('aria-current')) {
        e.preventDefault(); // уже этот язык — не перезагружаем
        return;
      }
      rememberSpot();
    }),
  );

  /* ---------- Спрятать при скролле вниз, показать при скролле вверх ---------- */
  let lastY = window.scrollY;
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        nav.classList.toggle('is-scrolled', y > 40);
        nav.classList.toggle('is-hidden', y > lastY && y > 400);
        lastY = y;
        ticking = false;
      });
    },
    { passive: true },
  );
  nav.addEventListener('focusin', () => nav.classList.remove('is-hidden'));

  /* ---------- Активный пункт ---------- */
  const navLinks = nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navLinks.forEach((l) => {
          const active = l.dataset.navLink === entry.target.id;
          l.classList.toggle('is-active', active);
          if (active) l.setAttribute('aria-current', 'location');
          else l.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinks.forEach((l) => {
    const section = document.getElementById(l.dataset.navLink!);
    if (section) io.observe(section);
  });

  /* ---------- Тема ---------- */
  const themeBtn = nav.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const syncThemeLabel = () => {
    const next = getTheme() === 'day' ? themeBtn.dataset.night : themeBtn.dataset.day;
    themeBtn.title = next ?? '';
  };
  syncThemeLabel();
  themeBtn.addEventListener('click', () => {
    setTheme(getTheme() === 'day' ? 'night' : 'day');
    syncThemeLabel();
  });

  /* ---------- Пауза «каракулей»: boil, живые позы стикмена ---------- */
  const stillBtn = nav.querySelector<HTMLButtonElement>('[data-still-toggle]')!;
  const syncStill = () => {
    const still = document.documentElement.classList.contains('is-still');
    stillBtn.setAttribute('aria-pressed', String(still));
    stillBtn.setAttribute('aria-label', (still ? stillBtn.dataset.labelPlay : stillBtn.dataset.labelPause) ?? '');
  };
  syncStill();
  stillBtn.addEventListener('click', () => {
    const still = document.documentElement.classList.toggle('is-still');
    try {
      localStorage.setItem('still', still ? '1' : '0');
    } catch {
      /* приватный режим — просто не запоминаем */
    }
    syncStill();
  });

  /* ---------- Мобильное меню ---------- */
  function setMenu(open: boolean) {
    menuBtn.setAttribute('aria-expanded', String(open));
    menuText.textContent = (open ? menuBtn.dataset.close : menuBtn.dataset.open) ?? '';
    lockScroll(open);
    if (open) {
      menu.hidden = false;
      // даём браузеру применить display, потом запускаем переход
      requestAnimationFrame(() => nav.classList.add('is-open'));
      menu.querySelector('a')?.focus({ preventScroll: true });
    } else {
      nav.classList.remove('is-open');
      menu.addEventListener('transitionend', () => !nav.classList.contains('is-open') && (menu.hidden = true), {
        once: true,
      });
    }
  }
  menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) {
      setMenu(false);
      menuBtn.focus();
    }
  });
</script>
