---
import type { Lang } from '../i18n';
import Base from '../layouts/Base.astro';
import Hero from './sections/Hero.astro';
import Intro from './sections/Intro.astro';
import Story from './sections/Story.astro';
import Work from './sections/Work.astro';
import Skills from './sections/Skills.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';
import Divider from './sketch/Divider.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang}>
  <Hero lang={lang} />
  <Intro lang={lang} />
  <Divider />
  <Story lang={lang} />
  <Work lang={lang} />
  <Skills lang={lang} />
  <Divider flip />
  <Contact lang={lang} />
  <Footer lang={lang} />
</Base>
