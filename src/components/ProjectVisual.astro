---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  class?: string;
  eager?: boolean;
}
const { project, class: className, eager = false } = Astro.props;
---

<div class:list={['visual', className]} style={`--h: ${project.hue}`}>
  {
    project.cover ? (
      <Image
        src={project.cover}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(max-width: 820px) 100vw, 40vw"
        loading={eager ? 'eager' : 'lazy'}
        class="visual__img"
      />
    ) : (
      <div class="visual__art" aria-hidden="true">
        <span class="visual__glyph">{project.title.charAt(0)}</span>
        <span class="visual__name">{project.title}</span>
      </div>
    )
  }
</div>

<style>
  .visual {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .visual__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Сгенерированная обложка: цвет проекта + токены страницы */
  .visual__art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 70% at 25% 30%, oklch(0.82 0.11 var(--h)), transparent 70%),
      radial-gradient(55% 60% at 80% 75%, oklch(0.72 0.14 calc(var(--h) + 40)), transparent 70%),
      radial-gradient(40% 40% at 70% 20%, color-mix(in oklch, var(--p-accent) 50%, transparent), transparent 70%),
      oklch(0.94 0.03 var(--h));
  }

  :global([data-theme='night']) .visual__art {
    background:
      radial-gradient(60% 70% at 25% 30%, oklch(0.45 0.12 var(--h)), transparent 70%),
      radial-gradient(55% 60% at 80% 75%, oklch(0.38 0.14 calc(var(--h) + 40)), transparent 70%),
      radial-gradient(40% 40% at 70% 20%, color-mix(in oklch, var(--p-accent) 35%, transparent), transparent 70%),
      oklch(0.2 0.03 var(--h));
  }

  .visual__glyph {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(6rem, 18vw, 14rem);
    line-height: 1;
    color: color-mix(in oklch, oklch(0.25 0.06 var(--h)) 80%, transparent);
    mix-blend-mode: soft-light;
  }

  :global([data-theme='night']) .visual__glyph {
    color: oklch(0.95 0.03 var(--h) / 0.5);
  }

  .visual__name {
    position: absolute;
    left: 1rem;
    bottom: 0.8rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: oklch(0.25 0.04 var(--h));
  }

  :global([data-theme='night']) .visual__name {
    color: oklch(0.92 0.03 var(--h));
  }
</style>
