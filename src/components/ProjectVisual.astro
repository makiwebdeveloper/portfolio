---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  class?: string;
  eager?: boolean;
}
const { project, class: className, eager = false } = Astro.props;
---

<div class:list={['visual', className]} style={`--h: ${project.hue}`}>
  {
    project.cover ? (
      <Image
        src={project.cover}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(max-width: 820px) 100vw, 40vw"
        loading={eager ? 'eager' : 'lazy'}
        class="visual__img"
      />
    ) : (
      <div class="visual__art" aria-hidden="true">
        <svg class="visual__doodles" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
          <path d="M40 60c20-26 52-30 70-8s-6 50-30 40-20-46 14-52" />
          <path d="M300 230l14 30 30-8-18 26 20 24-32-8-16 28-4-32-30-10 28-14z" />
          <path d="M320 50c10 10 30 10 40 0M326 72c8 6 22 6 30 0" />
          <path d="M50 240c30-10 60 14 90 4s50-20 80-6" />
        </svg>
        <span class="visual__glyph">{project.title.charAt(0)}</span>
      </div>
    )
  }
</div>

<style>
  .visual {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-surface);
  }

  .visual__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Сгенерированная обложка: бумага в цвете проекта + штриховка карандашом */
  .visual__art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(-40deg, oklch(0.72 0.11 var(--h) / 0.35) 0 2px, transparent 2px 11px),
      radial-gradient(70% 60% at 30% 35%, oklch(0.93 0.06 var(--h)), transparent 70%),
      oklch(0.86 0.07 var(--h));
  }

  :global([data-theme='night']) .visual__art {
    background:
      repeating-linear-gradient(-40deg, oklch(0.55 0.1 var(--h) / 0.35) 0 2px, transparent 2px 11px),
      radial-gradient(70% 60% at 30% 35%, oklch(0.42 0.08 var(--h)), transparent 70%),
      oklch(0.32 0.06 var(--h));
  }

  .visual__doodles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: oklch(0.4 0.1 var(--h));
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  :global([data-theme='night']) .visual__doodles {
    stroke: oklch(0.85 0.06 var(--h));
  }

  .visual__glyph {
    position: relative;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(6rem, 16vw, 12rem);
    line-height: 1;
    color: oklch(0.3 0.09 var(--h));
    rotate: -8deg;
  }
  :global([data-theme='night']) .visual__glyph {
    color: oklch(0.94 0.04 var(--h));
  }
</style>
