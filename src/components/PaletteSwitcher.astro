---
/** Только для разработки: быстро переключать палитры из tokens.css. */
import { PALETTES } from '../config/palettes';
---

<details class="palette" data-palette-switcher>
  <summary>Palette</summary>
  <div class="palette__list">
    {
      PALETTES.map((p) => (
        <button type="button" data-palette-btn={p}>
          {p}
        </button>
      ))
    }
  </div>
</details>

<style>
  .palette {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 950;
    padding: 0.5rem 0.8rem;
    border-radius: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    font-size: 0.75rem;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }
  .palette summary {
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .palette__list {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .palette button {
    text-align: left;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
  }
  .palette button[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>

<script>
  import { getPalette, setPalette, type Palette } from '../lib/theme';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-palette-btn]');
  const sync = () =>
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.paletteBtn === getPalette())));
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      setPalette(b.dataset.paletteBtn as Palette);
      sync();
    }),
  );
  sync();
</script>
