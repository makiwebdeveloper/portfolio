---
import '@fontsource-variable/cormorant';
import '@fontsource-variable/cormorant/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

import { languages, pathFor, useT, type Lang } from '../i18n';
import Preloader from '../components/Preloader.astro';
import OrbBackground from '../components/OrbBackground.astro';
import Cursor from '../components/Cursor.astro';
import Nav from '../components/Nav.astro';
import PaletteSwitcher from '../components/PaletteSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const canonical = new URL(pathFor(lang), Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={canonical} />
    {
      Object.keys(languages).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(pathFor(l as Lang), Astro.site)} />
      ))
    }
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f3f3ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a24" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- До первой отрисовки: тема, палитра, флаги для анимаций. -->
    <script is:inline>
      (() => {
        const de = document.documentElement;
        const read = (k) => {
          try {
            return localStorage.getItem(k);
          } catch {
            return null;
          }
        };
        const q = new URLSearchParams(location.search);
        const saved = q.get('theme') || read('theme');
        de.dataset.theme =
          saved === 'day' || saved === 'night'
            ? saved
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'night'
              : 'day';

        const palette = q.get('palette') || read('palette');
        if (palette && palette !== 'ice') de.dataset.palette = palette;

        de.classList.add('js', 'is-entering');

        let skip = q.has('no-preloader') || matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (sessionStorage.getItem('preloader-seen')) skip = true;
        } catch {}
        if (skip) de.classList.add('no-preloader');

        // Страховка: если JS-модули не загрузились, через 4 с показываем всё как есть.
        setTimeout(() => {
          de.classList.remove('is-entering');
          document.querySelector('[data-preloader]')?.remove();
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#work">{t('nav.skip')}</a>
    <Preloader />
    <OrbBackground />
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Cursor />
    {import.meta.env.DEV && <PaletteSwitcher />}

    <script>
      import { initSmoothScroll, initReveals } from '../lib/motion';
      import { initSceneTriggers } from '../lib/scene';

      initSmoothScroll();
      initReveals();
      initSceneTriggers();
    </script>
  </body>
</html>
