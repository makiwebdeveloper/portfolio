---
import '@fontsource-variable/caveat';
import '@fontsource-variable/nunito';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

import { languages, pathFor, useT, type Lang } from '../i18n';
import Preloader from '../components/Preloader.astro';
import Cursor from '../components/Cursor.astro';
import Nav from '../components/Nav.astro';
import Frame from '../components/Frame.astro';
import SketchDefs from '../components/sketch/SketchDefs.astro';
import Stickman from '../components/Stickman.astro';
// Рукописный шрифт грузим заранее: иначе hero успевает показаться запасным шрифтом
import caveatLatin from '@fontsource-variable/caveat/files/caveat-latin-wght-normal.woff2?url';
import caveatCyrillic from '@fontsource-variable/caveat/files/caveat-cyrillic-wght-normal.woff2?url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const canonical = new URL(pathFor(lang), Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={canonical} />
    {
      Object.keys(languages).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(pathFor(l as Lang), Astro.site)} />
      ))
    }
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f3eee3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={caveatLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'uk' && <link rel="preload" href={caveatCyrillic} as="font" type="font/woff2" crossorigin />}

    <!-- До первой отрисовки: тема, флаги для анимаций. -->
    <script is:inline>
      (() => {
        const de = document.documentElement;
        const read = (k) => {
          try {
            return localStorage.getItem(k);
          } catch {
            return null;
          }
        };
        const q = new URLSearchParams(location.search);
        const saved = q.get('theme') || read('theme');
        // По умолчанию всегда день (бумага); ночь — только если выбрали сами
        de.dataset.theme = saved === 'night' ? 'night' : 'day';

        // Пришли сменой языка (src/lib/relang.ts): без прелоадера и входа hero
        let relang = null;
        try {
          relang = sessionStorage.getItem('relang');
          sessionStorage.removeItem('relang');
        } catch {}
        if (relang !== null) {
          de.dataset.relang = relang;
          de.classList.add('is-relang');
        }

        de.classList.add('js');
        if (relang === null) de.classList.add('is-entering');
        if (read('still') === '1') de.classList.add('is-still');

        let skip = relang !== null || q.has('no-preloader') || matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (sessionStorage.getItem('preloader-seen')) skip = true;
        } catch {}
        if (skip) de.classList.add('no-preloader');

        // Страховка: если JS-модули не загрузились, через 4 с показываем всё как есть.
        setTimeout(() => {
          de.classList.remove('is-entering');
          document.querySelector('[data-preloader]')?.remove();
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <SketchDefs />
    <a class="skip-link" href="#work">{t('nav.skip')}</a>
    <Preloader />
    <div class="page-margin" aria-hidden="true"></div>
    <Frame />
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Stickman />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />

    <script>
      import { initSmoothScroll, initReveals, initOffscreenPause } from '../lib/motion';
      import { restoreSpot } from '../lib/relang';

      initSmoothScroll();
      initReveals();
      initOffscreenPause();
      restoreSpot();
    </script>
  </body>
</html>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>
